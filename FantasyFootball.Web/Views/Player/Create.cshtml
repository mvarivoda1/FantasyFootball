@model FantasyFootball.Models.ViewModels.PlayerFormViewModel
@{
    ViewData["Title"] = "Dodaj igrača";
}

<ul class="ff-breadcrumb">
    <li class="ff-breadcrumb__item"><a asp-controller="Home" asp-action="Index">Home</a></li>
    <li class="ff-breadcrumb__separator"><i class="bi bi-chevron-right"></i></li>
    <li class="ff-breadcrumb__item"><a asp-controller="Player" asp-action="Index">Igrači</a></li>
    <li class="ff-breadcrumb__separator"><i class="bi bi-chevron-right"></i></li>
    <li class="ff-breadcrumb__item ff-breadcrumb__item--active">Novi igrač</li>
</ul>

<section class="ff-form-shell" aria-labelledby="createPlayerTitle">
    <div class="ff-form-card" style="max-width: 720px;">
        <header class="ff-form-card__header">
            <h1 class="ff-form-card__title" id="createPlayerTitle">
                <i class="bi bi-person-plus-fill" aria-hidden="true"></i>
                <span>Dodaj novog igrača</span>
            </h1>
            <p class="ff-form-card__subtitle">
                Unesi osnovne podatke i statistiku igrača.
            </p>
        </header>

        @if (ViewBag.AiEnabled == true)
        {
            <section class="ff-ai-panel" aria-labelledby="ffAiTitle">
                <div class="ff-ai-panel__head">
                    <span class="ff-ai-panel__badge" aria-hidden="true">
                        <i class="bi bi-stars"></i>
                    </span>
                    <div class="ff-ai-panel__intro">
                        <h2 class="ff-ai-panel__title" id="ffAiTitle">AI unos</h2>
                        <p class="ff-ai-panel__subtitle">
                            Opiši igrača običnim rečenicama, a AI će popuniti polja umjesto tebe.
                        </p>
                    </div>
                </div>

                <div class="ff-ai-panel__field">
                    <label class="ff-form-label" for="ffAiPrompt">Opis igrača</label>
                    <textarea id="ffAiPrompt"
                              class="ff-form-input ff-ai-panel__textarea"
                              rows="3"
                              maxlength="600"
                              placeholder="npr. Dodaj Erling Haaland, napadač Manchester Cityja, 25 godina, 14 golova 3 asistencije, vrijednost 14M"
                              aria-describedby="ffAiStatus"></textarea>
                </div>

                <div class="ff-ai-panel__actions">
                    <button type="button" class="ff-ai-panel__btn" id="ffAiSubmit">
                        <span class="ff-ai-panel__btn-spinner" aria-hidden="true"></span>
                        <i class="bi bi-magic ff-ai-panel__btn-icon" aria-hidden="true"></i>
                        <span class="ff-ai-panel__btn-text">Popuni AI-em</span>
                    </button>
                    <p class="ff-ai-panel__hint">Provjeri popunjena polja prije spremanja.</p>
                </div>

                <div class="ff-ai-panel__status" id="ffAiStatus" role="status" aria-live="polite"></div>
            </section>
        }

        <form asp-controller="Player" asp-action="Create" method="post" class="ff-form" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="ff-form-alert" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="ff-form-field">
                        <label asp-for="FirstName" class="ff-form-label"></label>
                        <input asp-for="FirstName" class="ff-form-input" autocomplete="off" maxlength="50" />
                        <span asp-validation-for="FirstName" class="ff-form-validation"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="ff-form-field">
                        <label asp-for="LastName" class="ff-form-label"></label>
                        <input asp-for="LastName" class="ff-form-input" autocomplete="off" maxlength="50" />
                        <span asp-validation-for="LastName" class="ff-form-validation"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="ff-form-field">
                        <label asp-for="Position" class="ff-form-label"></label>
                        <select asp-for="Position" class="ff-form-input"
                                asp-items="Html.GetEnumSelectList<FantasyFootball.Models.Position>()">
                        </select>
                        <span asp-validation-for="Position" class="ff-form-validation"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="ff-form-field">
                        <label asp-for="Club" class="ff-form-label"></label>
                        @{
                            var clubAc = new FantasyFootball.Models.ViewModels.AutocompleteInputModel
                            {
                                Name = nameof(Model.Club),
                                Id = "Club",
                                InitialValue = Model.Club,
                                InitialLabel = Model.Club,
                                Endpoint = "/Player/Clubs",
                                Placeholder = "Pretraži ili upiši novi klub...",
                                Required = true,
                                FreeText = true
                            };
                        }
                        <partial name="_Autocomplete" model="clubAc" />
                        <span asp-validation-for="Club" class="ff-form-validation"></span>
                        <p class="ff-form-hint">Odaberi postojeći klub ili upiši novi.</p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="ff-form-field">
                        <label asp-for="Nationality" class="ff-form-label"></label>
                        <input asp-for="Nationality" class="ff-form-input" autocomplete="off" maxlength="60" />
                        <span asp-validation-for="Nationality" class="ff-form-validation"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="ff-form-field">
                        <label asp-for="DateOfBirth" class="ff-form-label"></label>
                        @{
                            var dobDp = new FantasyFootball.Models.ViewModels.DatePickerInputModel
                            {
                                Name = nameof(Model.DateOfBirth),
                                Id = "DateOfBirth",
                                Value = Model.DateOfBirth,
                                IncludeTime = false,
                                Required = true
                            };
                        }
                        <partial name="_DatePicker" model="dobDp" />
                        <span asp-validation-for="DateOfBirth" class="ff-form-validation"></span>
                    </div>
                </div>

                <div class="col-12">
                    <div class="ff-form-field">
                        <label asp-for="MarketValue" class="ff-form-label"></label>
                        <input asp-for="MarketValue" type="number" min="0.1" max="200" step="0.1"
                               class="ff-form-input" inputmode="decimal" />
                        <span asp-validation-for="MarketValue" class="ff-form-validation"></span>
                        <p class="ff-form-hint">Vrijednost u milijunima eura (0.1 – 200).</p>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="ff-form-field">
                        <label asp-for="Goals" class="ff-form-label"></label>
                        <input asp-for="Goals" type="number" min="0" max="1000" step="1"
                               class="ff-form-input" inputmode="numeric" />
                        <span asp-validation-for="Goals" class="ff-form-validation"></span>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="ff-form-field">
                        <label asp-for="Assists" class="ff-form-label"></label>
                        <input asp-for="Assists" type="number" min="0" max="1000" step="1"
                               class="ff-form-input" inputmode="numeric" />
                        <span asp-validation-for="Assists" class="ff-form-validation"></span>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="ff-form-field">
                        <label asp-for="CleanSheets" class="ff-form-label"></label>
                        <input asp-for="CleanSheets" type="number" min="0" max="1000" step="1"
                               class="ff-form-input" inputmode="numeric" />
                        <span asp-validation-for="CleanSheets" class="ff-form-validation"></span>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="ff-form-field">
                        <label asp-for="TotalPoints" class="ff-form-label"></label>
                        <input asp-for="TotalPoints" type="number" min="0" max="10000" step="1"
                               class="ff-form-input" inputmode="numeric" />
                        <span asp-validation-for="TotalPoints" class="ff-form-validation"></span>
                    </div>
                </div>
            </div>

            <div class="ff-form-actions">
                <button type="submit" class="ff-form-submit">
                    <i class="bi bi-plus-circle-fill" aria-hidden="true"></i>
                    <span>Dodaj igrača</span>
                </button>
                <a asp-controller="Player" asp-action="Index" class="ff-form-cancel">
                    Odustani
                </a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (ViewBag.AiEnabled == true)
    {
        <script>
            (function () {
                'use strict';

                var submitBtn = document.getElementById('ffAiSubmit');
                var promptEl = document.getElementById('ffAiPrompt');
                var statusEl = document.getElementById('ffAiStatus');
                var panel = document.querySelector('.ff-ai-panel');
                if (!submitBtn || !promptEl || !statusEl) return;

                function showStatus(type, message) {
                    statusEl.className = 'ff-ai-panel__status ff-ai-panel__status--' + type + ' is-shown';
                    var icon = type === 'error'
                        ? 'bi-exclamation-triangle-fill'
                        : (type === 'success' ? 'bi-check-circle-fill' : 'bi-info-circle-fill');
                    statusEl.innerHTML = '<i class="bi ' + icon + '" aria-hidden="true"></i><span>' + message + '</span>';
                }

                function clearStatus() {
                    statusEl.className = 'ff-ai-panel__status';
                    statusEl.textContent = '';
                }

                function setLoading(isLoading) {
                    submitBtn.disabled = isLoading;
                    promptEl.disabled = isLoading;
                    if (panel) panel.classList.toggle('is-loading', isLoading);
                }

                // --- Field helpers ---------------------------------------------------
                function setInput(id, value) {
                    var el = document.getElementById(id);
                    if (!el || value === undefined || value === null) return;
                    el.value = value;
                    el.dispatchEvent(new Event('input', { bubbles: true }));
                    el.dispatchEvent(new Event('change', { bubbles: true }));
                    flash(el);
                }

                function setSelect(id, value) {
                    var el = document.getElementById(id);
                    if (!el || value === undefined || value === null) return;
                    var v = String(value);
                    var matched = false;
                    Array.prototype.forEach.call(el.options, function (opt) {
                        if (opt.value.toLowerCase() === v.toLowerCase()) {
                            el.value = opt.value;
                            matched = true;
                        }
                    });
                    if (matched) {
                        el.dispatchEvent(new Event('change', { bubbles: true }));
                        flash(el);
                    }
                }

                // Autocomplete (Club): set hidden (binding) + visible (display) inputs.
                function setAutocomplete(rootId, value) {
                    if (value === undefined || value === null || value === '') return;
                    var hidden = document.getElementById(rootId + '_hidden');
                    var visible = document.getElementById(rootId + '_visible');
                    if (hidden) {
                        hidden.value = value;
                        hidden.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                    if (visible) {
                        visible.value = value;
                        flash(visible);
                        var clearBtn = visible.closest('.ff-ac');
                        clearBtn = clearBtn && clearBtn.querySelector('[data-ff-ac-clear]');
                        if (clearBtn) clearBtn.style.display = '';
                    }
                }

                // Datepicker (DateOfBirth): set hidden ISO + formatted visible value.
                function pad2(n) { return n < 10 ? '0' + n : '' + n; }

                function setDatePicker(rootId, isoValue) {
                    if (!isoValue) return;
                    var parts = String(isoValue).split('-');
                    if (parts.length !== 3) return;
                    var year = parseInt(parts[0], 10);
                    var month = parseInt(parts[1], 10);
                    var day = parseInt(parts[2], 10);
                    if (isNaN(year) || isNaN(month) || isNaN(day)) return;

                    var hidden = document.getElementById(rootId + '_hidden');
                    var visible = document.getElementById(rootId + '_visible');
                    if (hidden) {
                        hidden.value = year + '-' + pad2(month) + '-' + pad2(day);
                        hidden.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                    if (visible) {
                        var root = visible.closest('[data-ff-datepicker]');
                        var format = (root && root.getAttribute('data-format')) || 'dd.MM.yyyy';
                        visible.value = format
                            .replace('dd', pad2(day))
                            .replace('MM', pad2(month))
                            .replace('yyyy', year)
                            .replace(/\s*HH:mm.*$/, '')
                            .replace(/\s*hh:mm.*$/, '');
                        flash(visible);
                    }
                }

                function flash(el) {
                    el.classList.add('ff-ai-filled');
                    setTimeout(function () { el.classList.remove('ff-ai-filled'); }, 1200);
                }

                function fillForm(p) {
                    if (!p) return;
                    setInput('FirstName', p.firstName);
                    setInput('LastName', p.lastName);
                    setSelect('Position', p.position);
                    setAutocomplete('Club', p.club);
                    setInput('Nationality', p.nationality);
                    setDatePicker('DateOfBirth', p.dateOfBirth);
                    setInput('MarketValue', p.marketValue);
                    setInput('Goals', p.goals);
                    setInput('Assists', p.assists);
                    setInput('CleanSheets', p.cleanSheets);
                    setInput('TotalPoints', p.totalPoints);
                }

                // --- Submit ----------------------------------------------------------
                submitBtn.addEventListener('click', function () {
                    var prompt = (promptEl.value || '').trim();
                    if (!prompt) {
                        showStatus('error', 'Unesi opis igrača prije pokretanja AI-a.');
                        promptEl.focus();
                        return;
                    }

                    var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                    var fd = new FormData();
                    fd.append('prompt', prompt);
                    if (tokenEl) fd.append('__RequestVerificationToken', tokenEl.value);

                    setLoading(true);
                    showStatus('info', 'AI analizira opis...');

                    fetch('/Player/AiParse', {
                        method: 'POST',
                        body: fd,
                        credentials: 'same-origin',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                        .then(function (r) { return r.json().catch(function () { return null; }); })
                        .then(function (data) {
                            if (data && data.ok && data.player) {
                                fillForm(data.player);
                                showStatus('success', 'Polja su popunjena. Provjeri ih i spremi.');
                            } else {
                                var msg = (data && data.message) ? data.message : 'AI nije uspio obraditi opis.';
                                showStatus('error', msg);
                            }
                        })
                        .catch(function () {
                            showStatus('error', 'Greška u komunikaciji s AI servisom. Pokušaj ponovno.');
                        })
                        .finally(function () {
                            setLoading(false);
                        });
                });

                // Ctrl/Cmd + Enter shortcut from textarea
                promptEl.addEventListener('keydown', function (e) {
                    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                        e.preventDefault();
                        submitBtn.click();
                    }
                });
            })();
        </script>
    }
}
