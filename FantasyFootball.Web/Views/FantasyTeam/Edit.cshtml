@model FantasyFootball.Models.ViewModels.EditFantasyTeamViewModel
@{
    ViewData["Title"] = "Uredi tim";
}

<ul class="ff-breadcrumb">
    <li class="ff-breadcrumb__item"><a asp-controller="Home" asp-action="Index">Home</a></li>
    <li class="ff-breadcrumb__separator"><i class="bi bi-chevron-right"></i></li>
    <li class="ff-breadcrumb__item"><a asp-controller="FantasyTeam" asp-action="MyTeam">Moj tim</a></li>
    <li class="ff-breadcrumb__separator"><i class="bi bi-chevron-right"></i></li>
    <li class="ff-breadcrumb__item ff-breadcrumb__item--active">Uredi</li>
</ul>

<div class="row g-4">
    <div class="col-lg-6">
        <section class="ff-form-shell" aria-labelledby="editTeamTitle">
            <div class="ff-form-card">
                <header class="ff-form-card__header">
                    <h1 class="ff-form-card__title" id="editTeamTitle">
                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                        <span>Uredi tim</span>
                    </h1>
                    <p class="ff-form-card__subtitle">
                        Promijeni naziv tima ili ime vlasnika.
                    </p>
                </header>

                <form asp-controller="FantasyTeam" asp-action="Edit" method="post" class="ff-form" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="ff-form-alert" role="alert"></div>

                    <div class="ff-form-field">
                        <label asp-for="Name" class="ff-form-label"></label>
                        <input asp-for="Name"
                               class="ff-form-input"
                               autocomplete="off"
                               maxlength="60"
                               placeholder="npr. Galaktikosi" />
                        <span asp-validation-for="Name" class="ff-form-validation"></span>
                        <p class="ff-form-hint">Između 2 i 60 znakova.</p>
                    </div>

                    <div class="ff-form-field">
                        <label asp-for="OwnerName" class="ff-form-label"></label>
                        <input asp-for="OwnerName"
                               class="ff-form-input"
                               autocomplete="off"
                               maxlength="100"
                               placeholder="Ime i prezime vlasnika" />
                        <span asp-validation-for="OwnerName" class="ff-form-validation"></span>
                        <p class="ff-form-hint">Između 2 i 100 znakova.</p>
                    </div>

                    <div class="ff-form-actions">
                        <button type="submit" class="ff-form-submit">
                            <i class="bi bi-save-fill" aria-hidden="true"></i>
                            <span>Spremi promjene</span>
                        </button>
                        <a asp-controller="FantasyTeam" asp-action="MyTeam" class="ff-form-cancel">
                            Odustani
                        </a>
                    </div>
                </form>
            </div>
        </section>
    </div>

    <div class="col-lg-6">
        <div class="ff-logo-panel">
            <h2 class="ff-form-card__title" style="font-size:1.1rem;">
                <i class="bi bi-image" aria-hidden="true"></i>
                <span>Logo tima</span>
            </h2>
            <p class="ff-form-card__subtitle">
                Jedna slika koja predstavlja tvoj tim — do 5 MB, formati jpg, png, gif ili webp.
            </p>

            @* Standalone antiforgery token za AJAX uklanjanje loga *@
            @Html.AntiForgeryToken()

            <div class="ff-logo-preview" data-role="logo-preview">
                <img src="@Model.LogoPath"
                     alt="Logo tima @Model.Name"
                     class="ff-logo-preview__img @(string.IsNullOrEmpty(Model.LogoPath) ? "is-hidden" : "")"
                     data-role="logo-img" />
                <div class="ff-logo-preview__placeholder @(string.IsNullOrEmpty(Model.LogoPath) ? "" : "is-hidden")"
                     data-role="logo-placeholder"
                     aria-hidden="true">
                    <i class="bi bi-image" aria-hidden="true"></i>
                    <span>Nema loga</span>
                </div>
            </div>

            <button type="button"
                    class="ff-logo-remove @(string.IsNullOrEmpty(Model.LogoPath) ? "is-hidden" : "")"
                    data-role="logo-remove">
                <i class="bi bi-trash3" aria-hidden="true"></i>
                <span>Ukloni logo</span>
            </button>

            <form id="logoDz"
                  asp-controller="FantasyTeam"
                  asp-action="UploadLogo"
                  asp-route-teamId="@Model.Id"
                  enctype="multipart/form-data"
                  class="dropzone ff-logo-uploader"></form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="~/lib/dropzone/dropzone.min.css" />
    <script src="~/lib/dropzone/dropzone.min.js"></script>
    <script type="text/javascript">
        Dropzone.options.logoDz = {
            maxFiles: 1,
            maxFilesize: 5, // MB
            acceptedFiles: "image/*",
            dictDefaultMessage: "Povuci logo ovdje ili klikni za odabir",
            success: function (file, response) {
                if (response && response.logoPath) {
                    var $img = $('[data-role="logo-img"]');
                    $img.attr("src", response.logoPath).removeClass("is-hidden");
                    $('[data-role="logo-placeholder"]').addClass("is-hidden");
                    $('[data-role="logo-remove"]').removeClass("is-hidden");
                }
                // Ostavi uploader čist za sljedeću zamjenu
                this.removeAllFiles();
            },
            error: function (file, response) {
                var msg = (typeof response === "string")
                    ? response
                    : (response && response.message ? response.message : "Učitavanje loga nije uspjelo.");
                $(file.previewElement).find("[data-dz-errormessage]").text(msg);
            }
        };

        $(function () {
            $('[data-role="logo-remove"]').on("click", function () {
                var token = $('input[name="__RequestVerificationToken"]').first().val();
                $.ajax({
                    url: "@Url.Action("RemoveLogo", "FantasyTeam")",
                    method: "POST",
                    data: { teamId: @Model.Id, __RequestVerificationToken: token },
                    success: function () {
                        $('[data-role="logo-img"]').addClass("is-hidden").attr("src", "");
                        $('[data-role="logo-placeholder"]').removeClass("is-hidden");
                        $('[data-role="logo-remove"]').addClass("is-hidden");
                    }
                });
            });
        });
    </script>
}
