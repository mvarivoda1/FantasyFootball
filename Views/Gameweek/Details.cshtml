@model Gameweek
@{
    ViewData["Title"] = $"Gameweek {Model.WeekNumber}";
    var totalPerformances = Model.Performances?.Count ?? 0;
}

<!-- Breadcrumb -->
<ul class="ff-breadcrumb">
    <li class="ff-breadcrumb__item"><a asp-controller="Home" asp-action="Index">Home</a></li>
    <li class="ff-breadcrumb__separator"><i class="bi bi-chevron-right"></i></li>
    <li class="ff-breadcrumb__item"><a asp-controller="Gameweek" asp-action="Index">Gameweeks</a></li>
    <li class="ff-breadcrumb__separator"><i class="bi bi-chevron-right"></i></li>
    <li class="ff-breadcrumb__item ff-breadcrumb__item--active">Gameweek @Model.WeekNumber</li>
</ul>

<!-- Compact Title -->
<h1 class="ff-page-title"><i class="bi bi-calendar-event-fill"></i> Gameweek @Model.WeekNumber</h1>
<div class="ff-page-title__meta">
    <span><i class="bi bi-calendar3"></i>@Model.StartDate.ToString("dd MMM yyyy") &ndash; @Model.EndDate.ToString("dd MMM yyyy")</span>
    <span class="ff-page-title__meta-sep">|</span>
    <span><i class="bi bi-people-fill"></i>@totalPerformances performances</span>
</div>

@if (Model.Performances != null && Model.Performances.Any())
{
    <!-- Filter Bar -->
    <div class="ff-locker-filter ff-animate-in" role="search" aria-label="Filter performances">
        <div class="ff-locker-filter__controls">
            <div class="ff-locker-filter__group">
                <label for="filterPosition" class="ff-locker-filter__label">
                    <i class="bi bi-person-badge-fill" aria-hidden="true"></i>
                    <span class="ff-locker-filter__label-text">Position</span>
                </label>
                <select id="filterPosition" class="ff-locker-filter__select" aria-label="Filter performances by position">
                    <option value="">All Positions</option>
                    <option value="Goalkeeper">Goalkeeper</option>
                    <option value="Defender">Defender</option>
                    <option value="Midfielder">Midfielder</option>
                    <option value="Forward">Forward</option>
                </select>
            </div>
        </div>
        <div class="ff-locker-filter__status">
            <span class="ff-locker-filter__count" id="filterCount">
                Showing <strong>@totalPerformances</strong> of <strong>@totalPerformances</strong> performances
            </span>
        </div>
    </div>

    <!-- Empty Filter State -->
    <div class="ff-locker-filter-empty" id="filterEmptyState" style="display:none;">
        <div class="ff-locker-filter-empty__icon"><i class="bi bi-funnel"></i></div>
        <div class="ff-locker-filter-empty__text">No performances match the selected position</div>
        <button type="button" class="ff-locker-filter-empty__clear" id="filterClearAll">
            <i class="bi bi-arrow-counterclockwise"></i> Clear filter
        </button>
    </div>

    <!-- Performances Table -->
    <div class="ff-table-responsive">
        <table class="ff-table ff-table--sortable" id="ff-performances-table" aria-label="Gameweek performances">
            <thead>
                <tr>
                    <th scope="col">Player</th>
                    <th scope="col">Pos</th>
                    <th scope="col">Opponent</th>
                    <th class="ff-th-sort" data-sort-key="goals" data-sort-type="number" tabindex="0" role="button" aria-sort="none" scope="col">
                        <span class="ff-th-sort__inner">
                            Goals <i class="bi bi-arrow-down-up ff-th-sort__icon" aria-hidden="true"></i>
                        </span>
                    </th>
                    <th class="ff-th-sort" data-sort-key="assists" data-sort-type="number" tabindex="0" role="button" aria-sort="none" scope="col">
                        <span class="ff-th-sort__inner">
                            Assists <i class="bi bi-arrow-down-up ff-th-sort__icon" aria-hidden="true"></i>
                        </span>
                    </th>
                    <th scope="col">Clean Sheet</th>
                    <th scope="col">YC</th>
                    <th scope="col">RC</th>
                    <th class="ff-th-sort" data-sort-key="minutes" data-sort-type="number" tabindex="0" role="button" aria-sort="none" scope="col">
                        <span class="ff-th-sort__inner">
                            Minutes <i class="bi bi-arrow-down-up ff-th-sort__icon" aria-hidden="true"></i>
                        </span>
                    </th>
                    <th class="ff-th-sort" data-sort-key="points" data-sort-type="number" tabindex="0" role="button" aria-sort="descending" scope="col">
                        <span class="ff-th-sort__inner">
                            Points <i class="bi bi-arrow-down ff-th-sort__icon" aria-hidden="true"></i>
                        </span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @{
                    // Default sort: Points desc
                    var sortedPerformances = Model.Performances
                        .OrderByDescending(p => p.PointsEarned)
                        .ToList();
                }
                @foreach (var perf in sortedPerformances)
                {
                    string badgeClass = perf.Player.Position switch
                    {
                        Position.Goalkeeper => "ff-badge--gk",
                        Position.Defender   => "ff-badge--def",
                        Position.Midfielder => "ff-badge--mid",
                        Position.Forward    => "ff-badge--fwd",
                        _ => "ff-badge--mid"
                    };

                    string posAbbr = perf.Player.Position switch
                    {
                        Position.Goalkeeper => "GK",
                        Position.Defender   => "DEF",
                        Position.Midfielder => "MID",
                        Position.Forward    => "FWD",
                        _ => "MID"
                    };

                    <tr data-position="@perf.Player.Position">
                        <td>
                            <a asp-controller="Player" asp-action="Details" asp-route-id="@perf.Player.Id">
                                @perf.Player.FullName
                            </a>
                        </td>
                        <td>
                            <span class="ff-badge @badgeClass">@posAbbr</span>
                        </td>
                        <td>@perf.Opponent</td>
                        <td class="ff-num" data-sort-value="@perf.Goals">@perf.Goals</td>
                        <td class="ff-num" data-sort-value="@perf.Assists">@perf.Assists</td>
                        <td>
                            @if (perf.CleanSheet)
                            {
                                <i class="bi bi-check-circle-fill ff-bool--true"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill ff-bool--false"></i>
                            }
                        </td>
                        <td>
                            @if (perf.YellowCards > 0)
                            {
                                <span style="color: var(--ff-status-pending);">@perf.YellowCards</span>
                            }
                            else
                            {
                                <span class="ff-text-muted">0</span>
                            }
                        </td>
                        <td>
                            @if (perf.RedCards > 0)
                            {
                                <span style="color: var(--ff-status-rejected);">@perf.RedCards</span>
                            }
                            else
                            {
                                <span class="ff-text-muted">0</span>
                            }
                        </td>
                        <td class="ff-num" data-sort-value="@perf.MinutesPlayed">@perf.MinutesPlayed'</td>
                        <td class="ff-num ff-num--accent" data-sort-value="@perf.PointsEarned">
                            <strong>@perf.PointsEarned</strong>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="ff-empty">
        <div class="ff-empty__icon"><i class="bi bi-list-stars"></i></div>
        <div class="ff-empty__text">No performances recorded for this gameweek.</div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            'use strict';

            var table = document.getElementById('ff-performances-table');
            if (!table) return;

            var tbody = table.querySelector('tbody');
            var allRows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
            var totalCount = allRows.length;

            var $positionFilter = $('#filterPosition');
            var $filterCount = $('#filterCount');
            var $emptyState = $('#filterEmptyState');
            var $tableWrapper = $(table).closest('.ff-table-responsive');
            var $clearAll = $('#filterClearAll');

            /* ---- Filtering ---- */
            function applyFilter() {
                var positionVal = $positionFilter.val();
                var visibleCount = 0;

                allRows.forEach(function (row) {
                    var rowPosition = row.getAttribute('data-position') || '';
                    var matches = !positionVal || rowPosition === positionVal;
                    if (matches) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                $filterCount.html('Showing <strong>' + visibleCount + '</strong> of <strong>' + totalCount + '</strong> performances');

                if (visibleCount === 0 && totalCount > 0) {
                    $emptyState.show();
                    $tableWrapper.hide();
                } else {
                    $emptyState.hide();
                    $tableWrapper.show();
                }
            }

            $positionFilter.on('change', applyFilter);
            $clearAll.on('click', function () {
                $positionFilter.val('');
                applyFilter();
            });

            /* ---- Sorting ---- */
            function compareValues(a, b, type, dir) {
                var mult = dir === 'ascending' ? 1 : -1;
                if (type === 'number') {
                    var na = parseFloat(a) || 0;
                    var nb = parseFloat(b) || 0;
                    return (na - nb) * mult;
                }
                return String(a).localeCompare(String(b)) * mult;
            }

            function sortBy(th) {
                var headers = table.querySelectorAll('thead th');
                var keyIndex = -1;
                headers.forEach(function (h, i) {
                    if (h === th) keyIndex = i;
                });
                if (keyIndex === -1) return;

                var current = th.getAttribute('aria-sort');
                var next = current === 'ascending' ? 'descending' : 'ascending';

                // Reset all other sortable headers
                table.querySelectorAll('thead th.ff-th-sort').forEach(function (h) {
                    if (h !== th) {
                        h.setAttribute('aria-sort', 'none');
                        var ic = h.querySelector('.ff-th-sort__icon');
                        if (ic) {
                            ic.classList.remove('bi-arrow-up', 'bi-arrow-down');
                            ic.classList.add('bi-arrow-down-up');
                        }
                    }
                });

                th.setAttribute('aria-sort', next);
                var icon = th.querySelector('.ff-th-sort__icon');
                if (icon) {
                    icon.classList.remove('bi-arrow-down-up', 'bi-arrow-up', 'bi-arrow-down');
                    icon.classList.add(next === 'ascending' ? 'bi-arrow-up' : 'bi-arrow-down');
                }

                var type = th.getAttribute('data-sort-type') || 'string';
                allRows.sort(function (ra, rb) {
                    var va = ra.children[keyIndex].getAttribute('data-sort-value');
                    var vb = rb.children[keyIndex].getAttribute('data-sort-value');
                    return compareValues(va, vb, type, next);
                });
                allRows.forEach(function (r) { tbody.appendChild(r); });
            }

            table.querySelectorAll('thead th.ff-th-sort').forEach(function (th) {
                th.addEventListener('click', function () { sortBy(th); });
                th.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        sortBy(th);
                    }
                });
            });
        })();
    </script>
}
