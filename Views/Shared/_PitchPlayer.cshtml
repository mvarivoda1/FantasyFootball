@model FantasyFootball.Models.Player
@{
    var shirtVariant = Model.Position switch
    {
        Position.Goalkeeper => "gk",
        Position.Defender => "def",
        Position.Midfielder => "mid",
        Position.Forward => "fwd",
        _ => "def"
    };
    var posCode = shirtVariant.ToUpperInvariant();
    var isStarter = ViewData["IsStarter"] as bool? ?? true;
    var showValue = ViewData["ShowValue"] as bool? ?? false;

    // Per-gameweek points context (set by My Team when a played gameweek is selected).
    // Absent elsewhere (e.g. Build) => defaults keep the season TotalPoints behaviour.
    var showGw = ViewData["ShowGwPoints"] as bool? ?? false;
    var gwPoints = ViewData["GwPoints"] as Dictionary<int, int>;
    var displayPoints = showGw
        ? (gwPoints != null && gwPoints.TryGetValue(Model.Id, out var p) ? p : 0)
        : Model.TotalPoints;

    var clubShort = string.IsNullOrEmpty(Model.Club)
        ? string.Empty
        : new string(Model.Club.Where(char.IsLetterOrDigit).Take(3).ToArray()).ToUpperInvariant();
}

<button type="button"
        class="ff-pitch-player ff-totw-player ff-pitch-player--@(isStarter ? "starter" : "bench")@(showGw ? " ff-totw-player--gw" : "")"
        data-player-id="@Model.Id"
        data-position="@posCode"
        data-starter="@(isStarter ? "true" : "false")"
        data-name="@Model.LastName"
        data-full-name="@Model.FullName"
        data-club="@clubShort"
        data-points="@displayPoints"
        data-goals="@Model.Goals"
        data-assists="@Model.Assists"
        aria-pressed="false"
        title="@Model.FullName — @displayPoints pts">
    <span class="ff-pitch-player__pos-tag ff-pitch-player__pos-tag--@shirtVariant" aria-hidden="true">@posCode</span>
    <div class="ff-totw-player__shirt ff-totw-player__shirt--@shirtVariant">
        <span class="ff-totw-player__points">@displayPoints</span>
    </div>
    <div class="ff-totw-player__name">@Model.LastName</div>
    @if (showValue)
    {
        <div class="ff-totw-player__stat">@Model.MarketValue.ToString("N1")M</div>
    }
    else
    {
        <div class="ff-totw-player__stat">@Model.Goals G &middot; @Model.Assists A</div>
    }
</button>
