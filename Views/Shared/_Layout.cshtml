@{
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;
    var htmlLang = currentCulture.StartsWith("hr", System.StringComparison.OrdinalIgnoreCase) ? "hr" : "en";
}
<!DOCTYPE html>
<html lang="@htmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FantasyFootball</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="ff-navbar navbar navbar-expand-lg" id="ffNavbar">
            <div class="container ff-navbar__inner">
                <button class="navbar-toggler ff-navbar__toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse ff-navbar__collapse" id="navbarMain">
                    <ul class="navbar-nav ff-navbar__nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link ff-nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> <span>Home</span>
                            </a>
                        </li>
                        @if (User?.Identity?.IsAuthenticated == true && User.Claims.Any(c => c.Type == "FantasyTeamId"))
                        {
                            <li class="nav-item">
                                <a class="nav-link ff-nav-link" asp-controller="FantasyTeam" asp-action="MyTeam">
                                    <i class="bi bi-shield-fill-check"></i> <span>My Team</span>
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link ff-nav-link" asp-controller="Player" asp-action="Index">
                                <i class="bi bi-people"></i> <span>Players</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link ff-nav-link" asp-controller="FantasyTeam" asp-action="Index">
                                <i class="bi bi-shield"></i> <span>Teams</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link ff-nav-link" asp-controller="League" asp-action="Index">
                                <i class="bi bi-diagram-3"></i> <span>Leagues</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link ff-nav-link" asp-controller="Gameweek" asp-action="Index">
                                <i class="bi bi-calendar-week"></i> <span>Gameweeks</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link ff-nav-link" asp-controller="Transfer" asp-action="Index">
                                <i class="bi bi-arrow-left-right"></i> <span>Transfers</span>
                            </a>
                        </li>
                    </ul>

                    <form method="get" action="/Search" role="search" class="ff-navsearch" id="ffNavSearch" autocomplete="off">
                        <label for="ffNavSearchInput" class="visually-hidden">Pretraži igrače, timove i lige</label>
                        <i class="bi bi-search ff-navsearch__icon" aria-hidden="true"></i>
                        <input type="search"
                               name="q"
                               id="ffNavSearchInput"
                               class="ff-navsearch__input"
                               placeholder="Pretraži igrače, timove, lige..."
                               aria-label="Pretraži igrače, timove i lige"
                               aria-autocomplete="list"
                               aria-controls="ffNavSearchResults"
                               aria-expanded="false"
                               role="combobox"
                               autocomplete="off" />
                        <button type="submit" class="ff-navsearch__submit" aria-label="Pokreni pretragu">
                            <i class="bi bi-arrow-return-left" aria-hidden="true"></i>
                        </button>
                        <div class="ff-navsearch__results" id="ffNavSearchResults" role="listbox" aria-label="Prijedlozi pretrage" hidden></div>
                    </form>

                    <ul class="navbar-nav ff-navbar__nav ff-navbar__auth">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item ff-nav-user">
                                <i class="bi bi-person-circle"></i>
                                <span>@User.Identity!.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="ff-nav-logout-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="nav-link ff-nav-link ff-nav-link--logout">
                                        <i class="bi bi-box-arrow-right"></i> <span>Odjava</span>
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link ff-nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> <span>Prijava</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ff-nav-link ff-nav-link--cta" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> <span>Registracija</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="ff-main">
            @RenderBody()
        </main>
    </div>

    <footer class="ff-footer">
        <div class="container d-flex justify-content-between align-items-center flex-wrap">
            <span>&copy; 2026 FantasyFootball</span>
            <span>Built with <i class="bi bi-heart-fill" style="color: var(--ff-accent);"></i> ASP.NET Core</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ff-datepicker.js" asp-append-version="true"></script>
    <script src="~/js/ff-autocomplete.js" asp-append-version="true"></script>
    <script src="~/js/ff-search.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
