@model FantasyFootball.Models.MatchPerformance

<a asp-controller="Player" asp-action="Details" asp-route-id="@Model.Player.Id" class="ff-totw-player" title="@Model.Player.FullName - @Model.PointsEarned points">
    <div class="ff-totw-player__shirt ff-totw-player__shirt--@Model.Player.Position.ToString().ToLower().Substring(0,3)">
        <span class="ff-totw-player__points">@Model.PointsEarned</span>
    </div>
    <div class="ff-totw-player__name">@Model.Player.LastName</div>
    <div class="ff-totw-player__stat">@Model.Goals G &middot; @Model.Assists A</div>
</a>
