@model List<Player>
@{
    ViewData["Title"] = "Players";
}

<h1 class="ff-page-title"><i class="bi bi-people"></i> Players</h1>

@if (Model == null || !Model.Any())
{
    <div class="ff-empty">
        <div class="ff-empty__icon"><i class="bi bi-people"></i></div>
        <div class="ff-empty__text">No players found.</div>
    </div>
}
else
{
    <!-- Filter Bar -->
    <div class="ff-locker-filter ff-animate-in" role="search" aria-label="Filter players">
        <div class="ff-locker-filter__controls">
            <div class="ff-locker-filter__group">
                <label for="filterClub" class="ff-locker-filter__label">
                    <i class="bi bi-funnel-fill" aria-hidden="true"></i>
                    <span class="ff-locker-filter__label-text">Club</span>
                </label>
                <select id="filterClub" class="ff-locker-filter__select" aria-label="Filter by club">
                    <option value="">All Clubs</option>
                    @foreach (var club in Model.Select(p => p.Club).Distinct().OrderBy(c => c))
                    {
                        <option value="@club">@club</option>
                    }
                </select>
            </div>
            <div class="ff-locker-filter__group">
                <label for="filterPosition" class="ff-locker-filter__label">
                    <i class="bi bi-person-badge-fill" aria-hidden="true"></i>
                    <span class="ff-locker-filter__label-text">Position</span>
                </label>
                <select id="filterPosition" class="ff-locker-filter__select" aria-label="Filter by position">
                    <option value="">All Positions</option>
                    <option value="Goalkeeper">Goalkeeper</option>
                    <option value="Defender">Defender</option>
                    <option value="Midfielder">Midfielder</option>
                    <option value="Forward">Forward</option>
                </select>
            </div>
            <div class="ff-locker-filter__group ff-locker-filter__group--search">
                <label for="filterSearch" class="ff-locker-filter__label">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <span class="ff-locker-filter__label-text">Search</span>
                </label>
                <div class="ff-locker-filter__input-wrapper">
                    <input type="text"
                           id="filterSearch"
                           class="ff-locker-filter__input"
                           placeholder="Search by player name..."
                           autocomplete="off"
                           aria-label="Search players by name" />
                    <button type="button"
                            id="filterSearchClear"
                            class="ff-locker-filter__input-clear"
                            aria-label="Clear search"
                            style="display:none;">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="ff-locker-filter__status">
            <span class="ff-locker-filter__count" id="filterCount">
                Showing <strong>@Model.Count</strong> of <strong>@Model.Count</strong> players
            </span>
        </div>
    </div>

    <!-- Empty Filter State -->
    <div class="ff-locker-filter-empty" id="filterEmptyState" style="display:none;">
        <div class="ff-locker-filter-empty__icon"><i class="bi bi-search"></i></div>
        <div class="ff-locker-filter-empty__text">No players match your filters</div>
        <button type="button" class="ff-locker-filter-empty__clear" id="filterClearAll">
            <i class="bi bi-arrow-counterclockwise"></i> Clear filters
        </button>
    </div>

    <!-- Locker Grid -->
    <div class="ff-locker-room">
        @foreach (var player in Model)
        {
            string stripeClass = player.Position switch
            {
                Position.Goalkeeper => "ff-locker__stripe--gk",
                Position.Defender   => "ff-locker__stripe--def",
                Position.Midfielder => "ff-locker__stripe--mid",
                Position.Forward    => "ff-locker__stripe--fwd",
                _ => "ff-locker__stripe--mid"
            };

            string badgeClass = player.Position switch
            {
                Position.Goalkeeper => "ff-badge--gk",
                Position.Defender   => "ff-badge--def",
                Position.Midfielder => "ff-badge--mid",
                Position.Forward    => "ff-badge--fwd",
                _ => "ff-badge--mid"
            };

            string posAbbr = player.Position switch
            {
                Position.Goalkeeper => "GK",
                Position.Defender   => "DEF",
                Position.Midfielder => "MID",
                Position.Forward    => "FWD",
                _ => "MID"
            };

            <div class="ff-locker"
                 role="button"
                 tabindex="0"
                 aria-label="Open locker for @player.FullName"
                 data-player-id="@player.Id"
                 data-player-name="@player.FullName"
                 data-player-club="@player.Club"
                 data-player-nationality="@player.Nationality"
                 data-player-position="@player.Position"
                 data-player-pos-abbr="@posAbbr"
                 data-player-badge="@badgeClass"
                 data-player-dob="@player.DateOfBirth.ToString("dd MMM yyyy")"
                 data-player-value="@player.MarketValue.ToString("N0")"
                 data-player-goals="@player.Goals"
                 data-player-assists="@player.Assists"
                 data-player-cleansheets="@player.CleanSheets"
                 data-player-points="@player.TotalPoints"
                 data-player-teams='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(player.FantasyTeams?.Select(t => new { t.Id, t.Name, t.OwnerName, t.TotalPoints })))'>
                <div class="ff-locker__door">
                    <!-- Position color stripe -->
                    <div class="ff-locker__stripe @stripeClass"></div>

                    <!-- Ventilation slots -->
                    <div class="ff-locker__vents" aria-hidden="true">
                        <span class="ff-locker__vent"></span>
                        <span class="ff-locker__vent"></span>
                        <span class="ff-locker__vent"></span>
                    </div>

                    <!-- Number plate -->
                    <div class="ff-locker__number-plate">@posAbbr #@player.Id</div>

                    <!-- Name plate -->
                    <div class="ff-locker__nameplate">
                        <div class="ff-locker__nameplate-bg">
                            <div class="ff-locker__player-name">@player.FullName</div>
                            <div class="ff-locker__club">@player.Club</div>
                        </div>
                        <div class="ff-locker__position-badge">
                            <span class="ff-badge @badgeClass">@posAbbr</span>
                        </div>
                    </div>

                    <!-- Handle -->
                    <div class="ff-locker__handle" aria-hidden="true"></div>

                    <!-- Bottom detail -->
                    <div class="ff-locker__bottom-detail" aria-hidden="true"></div>
                </div>
            </div>
        }
    </div>

    <!-- Modal Backdrop (single reusable instance) -->
    <div class="ff-locker-modal-backdrop" id="lockerModalBackdrop" aria-hidden="true">
        <div class="ff-locker-modal" role="dialog" aria-modal="true" aria-labelledby="lockerModalName">
            <div class="ff-locker-modal__door-wrapper">
                <!-- Animated door piece -->
                <div class="ff-locker-modal__door" aria-hidden="true">
                    <div class="ff-locker-modal__door-handle"></div>
                </div>

                <!-- Locker interior with player details -->
                <div class="ff-locker-modal__interior">
                    <button class="ff-locker-modal__close" aria-label="Close locker" id="lockerModalClose">
                        <i class="bi bi-x-lg"></i>
                    </button>

                    <!-- Header -->
                    <div class="ff-locker-modal__header">
                        <div class="ff-locker-modal__player-identity">
                            <div>
                                <h2 class="ff-locker-modal__name" id="lockerModalName"></h2>
                                <div class="ff-locker-modal__meta">
                                    <span id="lockerModalBadge"></span>
                                    <span><i class="bi bi-building"></i> <span id="lockerModalClub"></span></span>
                                    <span><i class="bi bi-globe"></i> <span id="lockerModalNationality"></span></span>
                                </div>
                            </div>
                            <div class="ff-locker-modal__points">
                                <div class="ff-locker-modal__points-value" id="lockerModalPoints"></div>
                                <div class="ff-locker-modal__points-label">Total Pts</div>
                            </div>
                        </div>
                    </div>

                    <!-- Stats -->
                    <div class="ff-locker-modal__stats">
                        <div class="ff-locker-modal__stat">
                            <div class="ff-locker-modal__stat-icon"><i class="bi bi-bullseye"></i></div>
                            <div class="ff-locker-modal__stat-value" id="lockerModalGoals"></div>
                            <div class="ff-locker-modal__stat-label">Goals</div>
                        </div>
                        <div class="ff-locker-modal__stat">
                            <div class="ff-locker-modal__stat-icon"><i class="bi bi-hand-thumbs-up-fill"></i></div>
                            <div class="ff-locker-modal__stat-value" id="lockerModalAssists"></div>
                            <div class="ff-locker-modal__stat-label">Assists</div>
                        </div>
                        <div class="ff-locker-modal__stat">
                            <div class="ff-locker-modal__stat-icon"><i class="bi bi-shield-fill-check"></i></div>
                            <div class="ff-locker-modal__stat-value" id="lockerModalCleanSheets"></div>
                            <div class="ff-locker-modal__stat-label">Clean Sheets</div>
                        </div>
                        <div class="ff-locker-modal__stat">
                            <div class="ff-locker-modal__stat-icon"><i class="bi bi-cash-stack"></i></div>
                            <div class="ff-locker-modal__stat-value" id="lockerModalValue"></div>
                            <div class="ff-locker-modal__stat-label">Value</div>
                        </div>
                        <div class="ff-locker-modal__stat">
                            <div class="ff-locker-modal__stat-icon"><i class="bi bi-cake2-fill"></i></div>
                            <div class="ff-locker-modal__stat-value" id="lockerModalDob"></div>
                            <div class="ff-locker-modal__stat-label">Born</div>
                        </div>
                    </div>

                    <hr class="ff-locker-modal__divider" />

                    <!-- Fantasy Teams -->
                    <div class="ff-locker-modal__teams">
                        <div class="ff-locker-modal__teams-title">
                            <i class="bi bi-shield-fill"></i> Fantasy Teams
                        </div>
                        <div class="ff-locker-modal__team-list" id="lockerModalTeams">
                            <!-- Populated by JS -->
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="ff-locker-modal__actions">
                        <a href="#" class="ff-locker-modal__details-link" id="lockerModalDetailsLink">
                            Full Details <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
$(function () {
    /* ---- Player Filter Logic ---- */
    var $lockers = $('.ff-locker');
    var totalCount = $lockers.length;
    var $clubFilter = $('#filterClub');
    var $positionFilter = $('#filterPosition');
    var $searchFilter = $('#filterSearch');
    var $searchClear = $('#filterSearchClear');
    var $filterCount = $('#filterCount');
    var $emptyState = $('#filterEmptyState');
    var $lockerRoom = $('.ff-locker-room');
    var $clearAll = $('#filterClearAll');

    function applyFilters() {
        var clubVal = $clubFilter.val().toLowerCase();
        var positionVal = $positionFilter.val();
        var searchVal = $searchFilter.val().toLowerCase().trim();
        var visibleCount = 0;

        $lockers.each(function () {
            var $locker = $(this);
            var playerClub = ($locker.data('player-club') || '').toString().toLowerCase();
            var playerPosition = ($locker.data('player-position') || '').toString();
            var playerName = ($locker.data('player-name') || '').toString().toLowerCase();

            var matchesClub = !clubVal || playerClub === clubVal;
            var matchesPosition = !positionVal || playerPosition === positionVal;
            var matchesSearch = !searchVal || playerName.indexOf(searchVal) !== -1;

            if (matchesClub && matchesPosition && matchesSearch) {
                $locker.show();
                visibleCount++;
            } else {
                $locker.hide();
            }
        });

        $filterCount.html('Showing <strong>' + visibleCount + '</strong> of <strong>' + totalCount + '</strong> players');

        if (visibleCount === 0 && totalCount > 0) {
            $emptyState.show();
            $lockerRoom.hide();
        } else {
            $emptyState.hide();
            $lockerRoom.show();
        }

        // Toggle the search clear button
        $searchClear.toggle(searchVal.length > 0);
    }

    $clubFilter.on('change', applyFilters);
    $positionFilter.on('change', applyFilters);
    $searchFilter.on('input', applyFilters);

    $searchClear.on('click', function () {
        $searchFilter.val('');
        applyFilters();
        $searchFilter.focus();
    });

    $clearAll.on('click', function () {
        $clubFilter.val('');
        $positionFilter.val('');
        $searchFilter.val('');
        applyFilters();
    });

    /* ---- Locker Modal Logic ---- */
    var $backdrop = $('#lockerModalBackdrop');
    var $modal = $backdrop.find('.ff-locker-modal');

    // Open locker modal
    function openLocker($locker) {
        var d = $locker.data();

        // Populate modal fields
        $('#lockerModalName').text(d.playerName);
        $('#lockerModalClub').text(d.playerClub);
        $('#lockerModalNationality').text(d.playerNationality);
        $('#lockerModalPoints').text(d.playerPoints);
        $('#lockerModalGoals').text(d.playerGoals);
        $('#lockerModalAssists').text(d.playerAssists);
        $('#lockerModalCleanSheets').text(d.playerCleansheets);
        $('#lockerModalValue').html('&euro;' + d.playerValue);
        $('#lockerModalDob').text(d.playerDob);

        // Badge
        var badgeCls = d.playerBadge;
        var posAbbr = d.playerPosAbbr;
        $('#lockerModalBadge').html('<span class="ff-badge ' + badgeCls + '">' + posAbbr + '</span>');

        // Details link
        $('#lockerModalDetailsLink').attr('href', '/Player/Details/' + d.playerId);

        // Fantasy teams
        var $teamsList = $('#lockerModalTeams');
        $teamsList.empty();

        var teams = d.playerTeams;
        if (teams && teams.length > 0) {
            for (var i = 0; i < teams.length; i++) {
                var t = teams[i];
                var teamName = t.Name || t.name;
                var teamOwner = t.OwnerName || t.ownerName;
                var teamPoints = t.TotalPoints != null ? t.TotalPoints : t.totalPoints;
                var teamId = t.Id != null ? t.Id : t.id;

                $teamsList.append(
                    '<div class="ff-locker-modal__team-row">' +
                        '<div class="ff-locker-modal__team-info">' +
                            '<a href="/FantasyTeam/Details/' + teamId + '" class="ff-locker-modal__team-name">' + teamName + '</a>' +
                            '<div class="ff-locker-modal__team-owner">' + teamOwner + '</div>' +
                        '</div>' +
                        '<div class="ff-locker-modal__team-points">' + teamPoints + '<small>pts</small></div>' +
                    '</div>'
                );
            }
        } else {
            $teamsList.html('<div class="ff-locker-modal__no-teams"><i class="bi bi-shield"></i> Not in any fantasy team</div>');
        }

        // Show modal
        $('body').addClass('ff-locker-modal-open');
        $backdrop.attr('aria-hidden', 'false');

        // Force a reflow before adding class so transition fires
        $backdrop[0].offsetHeight;
        $backdrop.addClass('ff-locker-modal--visible');

        // Focus close button
        setTimeout(function () {
            $('#lockerModalClose').focus();
        }, 100);
    }

    // Close locker modal
    function closeLocker() {
        $backdrop.removeClass('ff-locker-modal--visible');
        $('body').removeClass('ff-locker-modal-open');

        setTimeout(function () {
            $backdrop.attr('aria-hidden', 'true');
        }, 400);
    }

    // Click on locker
    $('.ff-locker').on('click', function () {
        openLocker($(this));
    });

    // Keyboard: Enter/Space on locker
    $('.ff-locker').on('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openLocker($(this));
        }
    });

    // Close button
    $('#lockerModalClose').on('click', function (e) {
        e.stopPropagation();
        closeLocker();
    });

    // Click outside modal (on backdrop)
    $backdrop.on('click', function (e) {
        if ($(e.target).closest('.ff-locker-modal').length === 0) {
            closeLocker();
        }
    });

    // Escape key
    $(document).on('keydown', function (e) {
        if (e.key === 'Escape' && $backdrop.hasClass('ff-locker-modal--visible')) {
            closeLocker();
        }
    });
});
</script>
}
