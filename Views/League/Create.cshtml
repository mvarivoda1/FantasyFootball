@model FantasyFootball.Models.ViewModels.CreateLeagueViewModel
@{
    ViewData["Title"] = "Kreiraj ligu";
}

<!-- Breadcrumb -->
<ul class="ff-breadcrumb">
    <li class="ff-breadcrumb__item"><a asp-controller="Home" asp-action="Index">Home</a></li>
    <li class="ff-breadcrumb__separator"><i class="bi bi-chevron-right"></i></li>
    <li class="ff-breadcrumb__item"><a asp-controller="League" asp-action="Index">Leagues</a></li>
    <li class="ff-breadcrumb__separator"><i class="bi bi-chevron-right"></i></li>
    <li class="ff-breadcrumb__item ff-breadcrumb__item--active">Kreiraj</li>
</ul>

<section class="ff-form-shell" aria-labelledby="createLeagueTitle">
    <div class="ff-form-card">
        <header class="ff-form-card__header">
            <h1 class="ff-form-card__title" id="createLeagueTitle">
                <i class="bi bi-diagram-3-fill" aria-hidden="true"></i>
                <span>Kreiraj novu ligu</span>
            </h1>
            <p class="ff-form-card__subtitle">
                Pokreni vlastitu fantasy ligu i pozovi prijatelje preko jedinstvene šifre.
            </p>
        </header>

        <form asp-controller="League" asp-action="Create" method="post" class="ff-form" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="ff-form-alert" role="alert"></div>

            <div class="ff-form-field">
                <label asp-for="Name" class="ff-form-label"></label>
                <input asp-for="Name"
                       class="ff-form-input"
                       autocomplete="off"
                       placeholder="npr. Liga prvaka 2026"
                       maxlength="100" />
                <span asp-validation-for="Name" class="ff-form-validation"></span>
                <p class="ff-form-hint">Između 3 i 100 znakova.</p>
            </div>

            <div class="ff-form-field">
                <label asp-for="MaxTeams" class="ff-form-label"></label>
                <input asp-for="MaxTeams"
                       type="number"
                       min="2"
                       max="20"
                       step="1"
                       class="ff-form-input"
                       inputmode="numeric" />
                <span asp-validation-for="MaxTeams" class="ff-form-validation"></span>
                <p class="ff-form-hint">Koliko ekipa može sudjelovati (2 – 20).</p>
            </div>

            <div class="ff-form-actions">
                <button type="submit" class="ff-form-submit">
                    <i class="bi bi-plus-circle-fill" aria-hidden="true"></i>
                    <span>Kreiraj ligu</span>
                </button>
                <a asp-controller="League" asp-action="Index" class="ff-form-cancel">
                    Odustani
                </a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
