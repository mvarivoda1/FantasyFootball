@model List<League>
@{
    ViewData["Title"] = "Leagues";
    // NAPOMENA: Kontroler može postaviti ViewData["CurrentUserId"] kako bi se
    // Edit/Delete linkovi prikazivali samo creator-u lige. Ako je null, prikazujemo
    // linkove svima (UI sloj — server svejedno autorizira na POST-u).
    var currentUserId = ViewData["CurrentUserId"] as int?;
}

<h1 class="ff-page-title"><i class="bi bi-diagram-3-fill"></i> Leagues</h1>

<div class="ff-action-bar" role="region" aria-label="Akcije za lige">
    <span class="ff-action-bar__label">
        Pokreni svoju ligu ili se pridruži postojećoj koristeći šifru.
    </span>
    <div class="ff-action-bar__buttons">
        <a asp-controller="League" asp-action="Create" class="ff-action-btn ff-action-btn--primary">
            <i class="bi bi-plus-circle-fill" aria-hidden="true"></i>
            <span>Kreiraj ligu</span>
        </a>
        <a asp-controller="League" asp-action="Join" class="ff-action-btn ff-action-btn--secondary">
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
            <span>Pridruži se ligi</span>
        </a>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="ff-empty">
        <div class="ff-empty__icon"><i class="bi bi-diagram-3"></i></div>
        <div class="ff-empty__text">No leagues found.</div>
    </div>
}
else
{
    <!-- AJAX search bar -->
    <div class="ff-search-bar" id="ffLeagueSearchBar" role="search">
        <i class="bi bi-search ff-search-bar__icon" aria-hidden="true"></i>
        <input type="text"
               id="ffLeagueSearchInput"
               class="ff-search-bar__input"
               placeholder="Pretraži lige po nazivu ili sezoni..."
               autocomplete="off"
               aria-label="Pretraga liga" />
        <span class="ff-search-bar__status" id="ffLeagueSearchStatus"></span>
        <button type="button"
                id="ffLeagueSearchClear"
                class="ff-search-bar__clear"
                aria-label="Obriši pretragu"
                style="display:none;">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
    </div>

    <div class="ff-table-responsive">
        <table class="ff-table ff-table--sortable" id="ff-leagues-table" aria-label="Leagues list">
            <thead>
                <tr>
                    <th class="ff-th-sort" data-sort-key="name" data-sort-type="string" tabindex="0" role="button" aria-sort="none" scope="col">
                        <span class="ff-th-sort__inner">
                            Name <i class="bi bi-arrow-down-up ff-th-sort__icon" aria-hidden="true"></i>
                        </span>
                    </th>
                    <th class="ff-th-sort" data-sort-key="season" data-sort-type="string" tabindex="0" role="button" aria-sort="none" scope="col">
                        <span class="ff-th-sort__inner">
                            Season <i class="bi bi-arrow-down-up ff-th-sort__icon" aria-hidden="true"></i>
                        </span>
                    </th>
                    <th class="ff-th-sort" data-sort-key="teams" data-sort-type="number" tabindex="0" role="button" aria-sort="none" scope="col">
                        <span class="ff-th-sort__inner">
                            Teams <i class="bi bi-arrow-down-up ff-th-sort__icon" aria-hidden="true"></i>
                        </span>
                    </th>
                    <th class="ff-th-sort" data-sort-key="points" data-sort-type="number" tabindex="0" role="button" aria-sort="descending" scope="col">
                        <span class="ff-th-sort__inner">
                            Total Points <i class="bi bi-arrow-down ff-th-sort__icon" aria-hidden="true"></i>
                        </span>
                    </th>
                    <th class="ff-th-sort" data-sort-key="transfers" data-sort-type="number" tabindex="0" role="button" aria-sort="none" scope="col">
                        <span class="ff-th-sort__inner">
                            Transfers <i class="bi bi-arrow-down-up ff-th-sort__icon" aria-hidden="true"></i>
                        </span>
                    </th>
                    <th class="ff-th-sort" data-sort-key="created" data-sort-type="number" tabindex="0" role="button" aria-sort="none" scope="col">
                        <span class="ff-th-sort__inner">
                            Created <i class="bi bi-arrow-down-up ff-th-sort__icon" aria-hidden="true"></i>
                        </span>
                    </th>
                    <th scope="col" class="text-end">Akcije</th>
                </tr>
            </thead>
            <tbody id="ffLeaguesTbody">
                @{
                    var sortedLeagues = Model
                        .OrderByDescending(l => l.Teams?.Sum(t => t.TotalPoints) ?? 0)
                        .ToList();
                }
                @foreach (var league in sortedLeagues)
                {
                    var teamCount = league.Teams?.Count ?? 0;
                    var totalPoints = league.Teams?.Sum(t => t.TotalPoints) ?? 0;
                    var acceptedTransfers = league.Transfers?.Count() ?? 0;
                    var detailsUrl = Url.Action("Details", "League", new { id = league.Id });
                    // Conditional Edit/Delete: prikazi samo creator-u (kontroler postavlja ViewData["CurrentUserId"]).
                    // Ako nije postavljeno, prikazi svima (server radi finalnu autorizaciju).
                    bool showActions = !currentUserId.HasValue || league.CreatorUserId == currentUserId.Value;

                    <tr class="ff-table__row--clickable"
                        tabindex="0"
                        role="link"
                        data-href="@detailsUrl"
                        data-search-name="@league.Name.ToLowerInvariant()"
                        data-search-season="@league.Season.ToLowerInvariant()"
                        aria-label="Otvori ligu @league.Name">
                        <td data-sort-value="@league.Name.ToLowerInvariant()">
                            <a asp-controller="League" asp-action="Details" asp-route-id="@league.Id">
                                @league.Name
                            </a>
                        </td>
                        <td data-sort-value="@league.Season">
                            <i class="bi bi-calendar3 ff-text-muted me-1"></i>@league.Season
                        </td>
                        <td class="ff-num" data-sort-value="@teamCount">
                            <strong>@teamCount</strong> <span class="ff-text-muted ff-text-sm">/ @league.MaxTeams</span>
                        </td>
                        <td class="ff-num ff-num--accent" data-sort-value="@totalPoints">
                            @totalPoints
                        </td>
                        <td class="ff-num" data-sort-value="@acceptedTransfers">
                            @acceptedTransfers
                        </td>
                        <td class="ff-num" data-sort-value="@league.CreatedAt.Ticks">
                            <span class="ff-text-muted ff-text-sm">@league.CreatedAt.ToString("dd MMM yyyy")</span>
                        </td>
                        <td class="text-end">
                            @if (showActions)
                            {
                                <div class="ff-row-actions" data-no-row-click>
                                    <a asp-controller="League" asp-action="Edit" asp-route-id="@league.Id"
                                       class="ff-row-action"
                                       title="Uredi"
                                       aria-label="Uredi ligu @league.Name">
                                        <i class="bi bi-pencil-fill" aria-hidden="true"></i>
                                    </a>
                                    <a asp-controller="League" asp-action="Delete" asp-route-id="@league.Id"
                                       class="ff-row-action ff-row-action--danger"
                                       title="Obriši"
                                       aria-label="Obriši ligu @league.Name">
                                        <i class="bi bi-trash3-fill" aria-hidden="true"></i>
                                    </a>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        (function () {
            'use strict';

            var table = document.getElementById('ff-leagues-table');
            if (!table) return;

            // --- Row click navigation ---
            table.addEventListener('click', function (e) {
                if (e.target.closest('a')) return;
                if (e.target.closest('.ff-th-sort')) return;
                if (e.target.closest('[data-no-row-click]')) return;
                var row = e.target.closest('.ff-table__row--clickable');
                if (!row) return;
                var href = row.getAttribute('data-href');
                if (href) window.location.href = href;
            });

            table.addEventListener('keydown', function (e) {
                var row = e.target.closest('.ff-table__row--clickable');
                if (!row) return;
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    var href = row.getAttribute('data-href');
                    if (href) window.location.href = href;
                }
            });

            // --- Sorting ---
            function compareValues(a, b, type, dir) {
                var mult = dir === 'ascending' ? 1 : -1;
                if (type === 'number') {
                    var na = parseFloat(a) || 0;
                    var nb = parseFloat(b) || 0;
                    return (na - nb) * mult;
                }
                return String(a).localeCompare(String(b)) * mult;
            }

            function sortBy(th) {
                var tbody = table.querySelector('tbody');
                if (!tbody) return;
                var headers = table.querySelectorAll('thead th.ff-th-sort');
                var keyIndex = -1;
                headers.forEach(function (h, i) { if (h === th) keyIndex = i; });
                if (keyIndex === -1) return;

                var current = th.getAttribute('aria-sort');
                var next = current === 'ascending' ? 'descending' : 'ascending';

                headers.forEach(function (h) {
                    if (h !== th) {
                        h.setAttribute('aria-sort', 'none');
                        var ic = h.querySelector('.ff-th-sort__icon');
                        if (ic) {
                            ic.classList.remove('bi-arrow-up', 'bi-arrow-down');
                            ic.classList.add('bi-arrow-down-up');
                        }
                    }
                });

                th.setAttribute('aria-sort', next);
                var icon = th.querySelector('.ff-th-sort__icon');
                if (icon) {
                    icon.classList.remove('bi-arrow-down-up', 'bi-arrow-up', 'bi-arrow-down');
                    icon.classList.add(next === 'ascending' ? 'bi-arrow-up' : 'bi-arrow-down');
                }

                var type = th.getAttribute('data-sort-type') || 'string';
                var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr:not(.ff-table__empty-row)'));
                rows.sort(function (ra, rb) {
                    var va = ra.children[keyIndex].getAttribute('data-sort-value');
                    var vb = rb.children[keyIndex].getAttribute('data-sort-value');
                    return compareValues(va, vb, type, next);
                });
                rows.forEach(function (r) { tbody.appendChild(r); });
            }

            table.querySelectorAll('thead th.ff-th-sort').forEach(function (th) {
                th.addEventListener('click', function () { sortBy(th); });
                th.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        sortBy(th);
                    }
                });
            });

            // --- AJAX Search ---
            var bar = document.getElementById('ffLeagueSearchBar');
            var input = document.getElementById('ffLeagueSearchInput');
            var clearBtn = document.getElementById('ffLeagueSearchClear');
            var statusEl = document.getElementById('ffLeagueSearchStatus');
            var tbody = document.getElementById('ffLeaguesTbody');
            if (!input || !tbody) return;

            var debounceTimer = null;
            var lastQuery = '';
            var cachedRows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
            var emptyRow = null;

            function ensureEmptyRow() {
                if (!emptyRow) {
                    emptyRow = document.createElement('tr');
                    emptyRow.className = 'ff-table__empty-row';
                    var td = document.createElement('td');
                    td.colSpan = 7;
                    td.textContent = 'Nema rezultata za zadanu pretragu.';
                    emptyRow.appendChild(td);
                }
                return emptyRow;
            }

            function clientFilter(q) {
                var qLow = q.toLowerCase();
                var visible = 0;
                cachedRows.forEach(function (r) {
                    var name = r.getAttribute('data-search-name') || '';
                    var season = r.getAttribute('data-search-season') || '';
                    var match = !qLow || name.indexOf(qLow) !== -1 || season.indexOf(qLow) !== -1;
                    r.style.display = match ? '' : 'none';
                    if (match) visible++;
                });
                if (emptyRow && emptyRow.parentNode) emptyRow.parentNode.removeChild(emptyRow);
                if (visible === 0 && cachedRows.length > 0) {
                    tbody.appendChild(ensureEmptyRow());
                }
                statusEl.textContent = q ? (visible + ' rez.') : '';
            }

            function serverSearch(q) {
                bar.classList.add('ff-search-bar--loading');
                fetch('/League/Search?q=' + encodeURIComponent(q), {
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
                })
                    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                    .then(function (results) {
                        var idSet = {};
                        (Array.isArray(results) ? results : []).forEach(function (item) {
                            var id = (item && item.id != null) ? item.id : item;
                            idSet[id] = true;
                        });
                        var visible = 0;
                        cachedRows.forEach(function (r) {
                            var href = r.getAttribute('data-href') || '';
                            var m = href.match(/\/(\d+)(?:\?|$|\/)/);
                            var rid = m ? parseInt(m[1], 10) : null;
                            var match = rid != null && idSet[rid];
                            r.style.display = match ? '' : 'none';
                            if (match) visible++;
                        });
                        if (emptyRow && emptyRow.parentNode) emptyRow.parentNode.removeChild(emptyRow);
                        if (visible === 0 && cachedRows.length > 0) {
                            tbody.appendChild(ensureEmptyRow());
                        }
                        statusEl.textContent = visible + ' rez.';
                    })
                    .catch(function () {
                        // Fallback: client-side filter
                        clientFilter(q);
                    })
                    .then(function () {
                        bar.classList.remove('ff-search-bar--loading');
                    });
            }

            function onInput() {
                var q = input.value.trim();
                clearBtn.style.display = q ? '' : 'none';
                if (q === lastQuery) return;
                lastQuery = q;

                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    if (!q) {
                        clientFilter('');
                        return;
                    }
                    serverSearch(q);
                }, 250);
            }

            input.addEventListener('input', onInput);
            clearBtn.addEventListener('click', function () {
                input.value = '';
                lastQuery = '';
                clearBtn.style.display = 'none';
                clientFilter('');
                input.focus();
            });
        })();
    </script>
}
