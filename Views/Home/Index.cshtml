@using FantasyFootball.Models
@using FantasyFootball.Models.ViewModels
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="ff-dashboard ff-animate-in" aria-label="Fantasy Football dashboard">

    <!-- ROW 1: Gameweek Status + Next Deadline -->
    <div class="row g-3 ff-dashboard__row">
        <div class="col-12 col-lg-8">
            <article class="ff-widget ff-widget--feature" aria-labelledby="gw-status-title">
                <header class="ff-widget__header">
                    <h2 id="gw-status-title" class="ff-widget__title">
                        <span class="ff-widget__icon"><i class="bi bi-calendar2-week-fill" aria-hidden="true"></i></span>
                        Gameweek @(Model.LatestGameweek?.WeekNumber ?? 0) Status
                    </h2>
                    <span class="ff-widget__badge ff-widget__badge--live">Finished</span>
                </header>
                <div class="ff-widget__body">
                    @if (Model.LatestGameweek != null)
                    {
                        <div class="ff-gw-stats">
                            <div class="ff-gw-stat">
                                <div class="ff-gw-stat__value">@Model.MatchesInLatestGw</div>
                                <div class="ff-gw-stat__label">Matches</div>
                            </div>
                            <div class="ff-gw-stat">
                                <div class="ff-gw-stat__value">@Model.TotalGoalsInLatestGw</div>
                                <div class="ff-gw-stat__label">Goals</div>
                            </div>
                            <div class="ff-gw-stat">
                                <div class="ff-gw-stat__value">@Model.TotalAssistsInLatestGw</div>
                                <div class="ff-gw-stat__label">Assists</div>
                            </div>
                            <div class="ff-gw-stat">
                                <div class="ff-gw-stat__value">@Model.TotalCleanSheetsInLatestGw</div>
                                <div class="ff-gw-stat__label">Clean Sheets</div>
                            </div>
                        </div>
                        <div class="ff-widget__meta">
                            <i class="bi bi-calendar-range" aria-hidden="true"></i>
                            @Model.LatestGameweek.StartDate.ToString("MMM d") &mdash; @Model.LatestGameweek.EndDate.ToString("MMM d, yyyy")
                        </div>
                    }
                    else
                    {
                        <p class="ff-widget__empty">No gameweek data available.</p>
                    }
                </div>
            </article>
        </div>

        <div class="col-12 col-lg-4">
            <article class="ff-widget ff-widget--countdown" aria-labelledby="next-deadline-title">
                <header class="ff-widget__header">
                    <h2 id="next-deadline-title" class="ff-widget__title">
                        <span class="ff-widget__icon"><i class="bi bi-stopwatch-fill" aria-hidden="true"></i></span>
                        Next Deadline
                    </h2>
                </header>
                <div class="ff-widget__body">
                    <div class="ff-countdown" data-deadline="@Model.NextDeadline.ToString("yyyy-MM-ddTHH:mm:ss")">
                        <div class="ff-countdown__unit">
                            <span class="ff-countdown__value" data-unit="days">--</span>
                            <span class="ff-countdown__label">Days</span>
                        </div>
                        <div class="ff-countdown__unit">
                            <span class="ff-countdown__value" data-unit="hours">--</span>
                            <span class="ff-countdown__label">Hrs</span>
                        </div>
                        <div class="ff-countdown__unit">
                            <span class="ff-countdown__value" data-unit="minutes">--</span>
                            <span class="ff-countdown__label">Min</span>
                        </div>
                        <div class="ff-countdown__unit">
                            <span class="ff-countdown__value" data-unit="seconds">--</span>
                            <span class="ff-countdown__label">Sec</span>
                        </div>
                    </div>
                    <div class="ff-widget__meta">
                        Gameweek @Model.NextGameweekNumber &middot; @Model.NextDeadline.ToString("ddd dd MMM, HH:mm")
                    </div>
                </div>
            </article>
        </div>
    </div>

    <!-- ROW 2: Player of the Week + Top Transfers In + Top Transfers Out -->
    <div class="row g-3 ff-dashboard__row">
        <div class="col-12 col-md-6 col-lg-4">
            <article class="ff-widget ff-widget--potw" aria-labelledby="potw-title">
                <header class="ff-widget__header">
                    <h2 id="potw-title" class="ff-widget__title">
                        <span class="ff-widget__icon"><i class="bi bi-star-fill" aria-hidden="true"></i></span>
                        Player of the Week
                    </h2>
                </header>
                <div class="ff-widget__body">
                    @if (Model.PlayerOfTheWeek != null)
                    {
                        var potw = Model.PlayerOfTheWeek;
                        <a asp-controller="Player" asp-action="Details" asp-route-id="@potw.Player.Id" class="ff-potw">
                            <div class="ff-potw__top">
                                <span class="ff-badge ff-badge--@potw.Player.Position.ToString().ToLower().Substring(0,3)">
                                    @potw.Player.Position
                                </span>
                                <span class="ff-potw__club">@potw.Player.Club</span>
                            </div>
                            <div class="ff-potw__name">@potw.Player.FullName</div>
                            <div class="ff-potw__score">
                                <span class="ff-potw__points">@potw.PointsEarned</span>
                                <span class="ff-potw__pts-label">PTS</span>
                            </div>
                            <div class="ff-potw__stats">
                                <span><i class="bi bi-bullseye" aria-hidden="true"></i> @potw.Goals G</span>
                                <span><i class="bi bi-hand-thumbs-up" aria-hidden="true"></i> @potw.Assists A</span>
                                <span><i class="bi bi-stopwatch" aria-hidden="true"></i> @potw.MinutesPlayed'</span>
                            </div>
                        </a>
                    }
                    else
                    {
                        <p class="ff-widget__empty">No data.</p>
                    }
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <article class="ff-widget" aria-labelledby="transfers-in-title">
                <header class="ff-widget__header">
                    <h2 id="transfers-in-title" class="ff-widget__title">
                        <span class="ff-widget__icon ff-widget__icon--in"><i class="bi bi-arrow-down-circle-fill" aria-hidden="true"></i></span>
                        Top Transfers In
                    </h2>
                </header>
                <div class="ff-widget__body ff-widget__body--list">
                    @if (Model.TopTransfersIn.Any())
                    {
                        <ul class="ff-widget-list">
                            @foreach (var item in Model.TopTransfersIn)
                            {
                                <li class="ff-widget-row">
                                    <div class="ff-widget-row__main">
                                        <a asp-controller="Player" asp-action="Details" asp-route-id="@item.Player.Id" class="ff-widget-row__name">
                                            @item.Player.FullName
                                        </a>
                                        <span class="ff-widget-row__sub">@item.Player.Club &middot; @item.Player.Position</span>
                                    </div>
                                    <div class="ff-widget-row__value ff-widget-row__value--up">
                                        <i class="bi bi-arrow-up-short" aria-hidden="true"></i>@item.TransferCount
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="ff-widget__empty">No transfers yet.</p>
                    }
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <article class="ff-widget" aria-labelledby="transfers-out-title">
                <header class="ff-widget__header">
                    <h2 id="transfers-out-title" class="ff-widget__title">
                        <span class="ff-widget__icon ff-widget__icon--out"><i class="bi bi-arrow-up-circle-fill" aria-hidden="true"></i></span>
                        Top Transfers Out
                    </h2>
                </header>
                <div class="ff-widget__body ff-widget__body--list">
                    @if (Model.TopTransfersOut.Any())
                    {
                        <ul class="ff-widget-list">
                            @foreach (var item in Model.TopTransfersOut)
                            {
                                <li class="ff-widget-row">
                                    <div class="ff-widget-row__main">
                                        <a asp-controller="Player" asp-action="Details" asp-route-id="@item.Player.Id" class="ff-widget-row__name">
                                            @item.Player.FullName
                                        </a>
                                        <span class="ff-widget-row__sub">@item.Player.Club &middot; @item.Player.Position</span>
                                    </div>
                                    <div class="ff-widget-row__value ff-widget-row__value--down">
                                        <i class="bi bi-arrow-down-short" aria-hidden="true"></i>@item.TransferCount
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="ff-widget__empty">No transfers yet.</p>
                    }
                </div>
            </article>
        </div>
    </div>

    <!-- ROW 3: Team of the Week (wide) + Player Availability -->
    <div class="row g-3 ff-dashboard__row">
        <div class="col-12 col-lg-8">
            <article class="ff-widget ff-widget--totw" aria-labelledby="totw-title">
                <header class="ff-widget__header">
                    <h2 id="totw-title" class="ff-widget__title">
                        <span class="ff-widget__icon"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
                        Team of the Week
                    </h2>
                    <span class="ff-widget__badge">GW @(Model.LatestGameweek?.WeekNumber ?? 0)</span>
                </header>
                <div class="ff-widget__body">
                    <div class="ff-totw">
                        @if (Model.TotwForwards.Any())
                        {
                            <div class="ff-totw__row ff-totw__row--fwd">
                                @foreach (var perf in Model.TotwForwards)
                                {
                                    <partial name="_TotwPlayer" model="perf" />
                                }
                            </div>
                        }
                        @if (Model.TotwMidfielders.Any())
                        {
                            <div class="ff-totw__row ff-totw__row--mid">
                                @foreach (var perf in Model.TotwMidfielders)
                                {
                                    <partial name="_TotwPlayer" model="perf" />
                                }
                            </div>
                        }
                        @if (Model.TotwDefenders.Any())
                        {
                            <div class="ff-totw__row ff-totw__row--def">
                                @foreach (var perf in Model.TotwDefenders)
                                {
                                    <partial name="_TotwPlayer" model="perf" />
                                }
                            </div>
                        }
                        @if (Model.TotwGoalkeepers.Any())
                        {
                            <div class="ff-totw__row ff-totw__row--gk">
                                @foreach (var perf in Model.TotwGoalkeepers)
                                {
                                    <partial name="_TotwPlayer" model="perf" />
                                }
                            </div>
                        }
                        @if (!Model.TotwForwards.Any() && !Model.TotwMidfielders.Any() && !Model.TotwDefenders.Any() && !Model.TotwGoalkeepers.Any())
                        {
                            <p class="ff-widget__empty">No performances recorded.</p>
                        }
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-lg-4">
            <article class="ff-widget" aria-labelledby="availability-title">
                <header class="ff-widget__header">
                    <h2 id="availability-title" class="ff-widget__title">
                        <span class="ff-widget__icon"><i class="bi bi-heart-pulse-fill" aria-hidden="true"></i></span>
                        Player Availability
                    </h2>
                </header>
                <div class="ff-widget__body ff-widget__body--list">
                    @if (Model.PlayerAvailability.Any())
                    {
                        <ul class="ff-widget-list">
                            @foreach (var item in Model.PlayerAvailability)
                            {
                                <li class="ff-widget-row">
                                    <div class="ff-widget-row__main">
                                        <a asp-controller="Player" asp-action="Details" asp-route-id="@item.Player.Id" class="ff-widget-row__name">
                                            @item.Player.FullName
                                        </a>
                                        <span class="ff-widget-row__sub">@item.Player.Club</span>
                                    </div>
                                    <div class="ff-status ff-status--@item.StatusClass" title="@item.Status (@item.ChancePercent%)">
                                        <span class="ff-status__dot" aria-hidden="true"></span>
                                        <span class="ff-status__text">@item.ChancePercent%</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="ff-widget__empty">No data.</p>
                    }
                </div>
            </article>
        </div>
    </div>

    <!-- ROW 4: Most Valuable Teams + Best Leagues + Top Scorers -->
    <div class="row g-3 ff-dashboard__row">
        <div class="col-12 col-md-6 col-lg-4">
            <article class="ff-widget" aria-labelledby="teams-title">
                <header class="ff-widget__header">
                    <h2 id="teams-title" class="ff-widget__title">
                        <span class="ff-widget__icon"><i class="bi bi-shield-fill-check" aria-hidden="true"></i></span>
                        Most Valuable Teams
                    </h2>
                </header>
                <div class="ff-widget__body ff-widget__body--list">
                    @if (Model.MostValuableTeams.Any())
                    {
                        <ol class="ff-widget-list ff-widget-list--ranked">
                            @{ int tr = 1; }
                            @foreach (var team in Model.MostValuableTeams)
                            {
                                <li class="ff-widget-row">
                                    <div class="ff-widget-row__rank">@tr</div>
                                    <div class="ff-widget-row__main">
                                        <a asp-controller="FantasyTeam" asp-action="Details" asp-route-id="@team.Id" class="ff-widget-row__name">
                                            @team.Name
                                        </a>
                                        <span class="ff-widget-row__sub">@team.OwnerName</span>
                                    </div>
                                    <div class="ff-widget-row__value ff-widget-row__value--points">
                                        @team.TotalPoints<small>pts</small>
                                    </div>
                                </li>
                                tr++;
                            }
                        </ol>
                    }
                    else
                    {
                        <p class="ff-widget__empty">No teams.</p>
                    }
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <article class="ff-widget" aria-labelledby="leagues-title">
                <header class="ff-widget__header">
                    <h2 id="leagues-title" class="ff-widget__title">
                        <span class="ff-widget__icon"><i class="bi bi-diagram-3-fill" aria-hidden="true"></i></span>
                        Best Leagues
                    </h2>
                </header>
                <div class="ff-widget__body ff-widget__body--list">
                    @if (Model.BestLeagues.Any())
                    {
                        <ul class="ff-widget-list">
                            @foreach (var item in Model.BestLeagues)
                            {
                                <li class="ff-widget-row">
                                    <div class="ff-widget-row__main">
                                        <a asp-controller="League" asp-action="Details" asp-route-id="@item.League.Id" class="ff-widget-row__name">
                                            @item.League.Name
                                        </a>
                                        <span class="ff-widget-row__sub">@item.TotalTeams teams &middot; avg @item.AveragePoints.ToString("N0") pts</span>
                                    </div>
                                    <div class="ff-widget-row__value ff-widget-row__value--points">
                                        @item.TotalPoints<small>pts</small>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="ff-widget__empty">No leagues.</p>
                    }
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <article class="ff-widget" aria-labelledby="scorers-title">
                <header class="ff-widget__header">
                    <h2 id="scorers-title" class="ff-widget__title">
                        <span class="ff-widget__icon"><i class="bi bi-bullseye" aria-hidden="true"></i></span>
                        Top Scorers
                    </h2>
                </header>
                <div class="ff-widget__body ff-widget__body--list">
                    @if (Model.TopScorers.Any())
                    {
                        <ol class="ff-widget-list ff-widget-list--ranked">
                            @{ int sr = 1; }
                            @foreach (var player in Model.TopScorers)
                            {
                                <li class="ff-widget-row">
                                    <div class="ff-widget-row__rank">@sr</div>
                                    <div class="ff-widget-row__main">
                                        <a asp-controller="Player" asp-action="Details" asp-route-id="@player.Id" class="ff-widget-row__name">
                                            @player.FullName
                                        </a>
                                        <span class="ff-widget-row__sub">@player.Club</span>
                                    </div>
                                    <div class="ff-widget-row__value ff-widget-row__value--points">
                                        @player.Goals<small>G</small>
                                    </div>
                                </li>
                                sr++;
                            }
                        </ol>
                    }
                    else
                    {
                        <p class="ff-widget__empty">No data.</p>
                    }
                </div>
            </article>
        </div>
    </div>

    <!-- Quick nav footer -->
    <nav class="ff-quick-nav" aria-label="Quick navigation">
        <a asp-controller="Player" asp-action="Index" class="ff-quick-nav__item">
            <i class="bi bi-people-fill" aria-hidden="true"></i><span>Players</span>
        </a>
        <a asp-controller="FantasyTeam" asp-action="Index" class="ff-quick-nav__item">
            <i class="bi bi-shield-fill" aria-hidden="true"></i><span>Teams</span>
        </a>
        <a asp-controller="League" asp-action="Index" class="ff-quick-nav__item">
            <i class="bi bi-diagram-3-fill" aria-hidden="true"></i><span>Leagues</span>
        </a>
        <a asp-controller="Gameweek" asp-action="Index" class="ff-quick-nav__item">
            <i class="bi bi-calendar-week-fill" aria-hidden="true"></i><span>Gameweeks</span>
        </a>
        <a asp-controller="Transfer" asp-action="Index" class="ff-quick-nav__item">
            <i class="bi bi-arrow-left-right" aria-hidden="true"></i><span>Transfers</span>
        </a>
    </nav>
</section>
