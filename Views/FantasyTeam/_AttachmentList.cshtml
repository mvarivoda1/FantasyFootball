@model List<FantasyFootball.Models.Attachment>
@functions {
    string FormatSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / (1024.0 * 1024.0):0.0} MB";
        if (bytes >= 1024)
            return $"{bytes / 1024.0:0.0} KB";
        return $"{bytes} B";
    }
}

@if (Model == null || Model.Count == 0)
{
    <p class="ff-form-hint mb-0"><i class="bi bi-inbox" aria-hidden="true"></i> Nema priloženih datoteka.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Datoteka</th>
                <th>Veličina</th>
                <th>Datum</th>
                <th class="text-end">Akcija</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var attachment in Model)
            {
                <tr>
                    <td>
                        <a href="@attachment.FilePath" target="_blank" rel="noopener">
                            <i class="bi bi-file-earmark" aria-hidden="true"></i> @attachment.FileName
                        </a>
                    </td>
                    <td>@FormatSize(attachment.FileSize)</td>
                    <td>@attachment.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-end">
                        <button type="button"
                                class="btn btn-danger btn-sm"
                                onclick="deleteAttachment(@attachment.Id)">
                            <i class="bi bi-trash" aria-hidden="true"></i> Obriši
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
