@model FantasyFootball.Models.ViewModels.MyTeamViewModel
@{
    ViewData["Title"] = "My Team";
    var savedMsg = TempData["LineupSaved"] as string;
    var firstGw = Model.Gameweeks.OrderBy(g => g.Number).FirstOrDefault();
}

<section class="ff-myteam"
         data-min-gk="@Model.MinGk" data-max-gk="@Model.MaxGk"
         data-min-def="@Model.MinDef" data-max-def="@Model.MaxDef"
         data-min-mid="@Model.MinMid" data-max-mid="@Model.MaxMid"
         data-min-fwd="@Model.MinFwd" data-max-fwd="@Model.MaxFwd"
         data-starters-count="@Model.StartersCount">

    <header class="ff-myteam__hero">
        <div class="ff-myteam__hero-bg" aria-hidden="true"></div>
        <div class="ff-myteam__hero-inner">
            <div class="ff-myteam__hero-text">
                @if (!string.IsNullOrEmpty(Model.LogoPath))
                {
                    <div class="ff-myteam__brand">
                        <img src="@Model.LogoPath"
                             alt="Logo tima @Model.TeamName"
                             class="ff-myteam__logo" />
                        <h1 class="ff-myteam__title">@Model.TeamName</h1>
                    </div>
                }
                else
                {
                    <h1 class="ff-myteam__title">@Model.TeamName</h1>
                }
                <p class="ff-myteam__subtitle">
                    Posloži svoj početni sastav. Klikni igrača na terenu, pa klikni drugog za zamjenu.
                </p>
                <div class="ff-row-actions" style="margin-top:0.7rem;">
                    <a asp-controller="FantasyTeam" asp-action="Edit" asp-route-id="@Model.TeamId"
                       class="ff-row-action"
                       title="Uredi tim"
                       aria-label="Uredi tim">
                        <i class="bi bi-pencil-fill" aria-hidden="true"></i>
                    </a>
                    <a asp-controller="FantasyTeam" asp-action="Delete" asp-route-id="@Model.TeamId"
                       class="ff-row-action ff-row-action--danger"
                       title="Obriši tim"
                       aria-label="Obriši tim">
                        <i class="bi bi-trash3-fill" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
            <div class="ff-myteam__hero-meta">
                <div class="ff-myteam__formation-card">
                    <span class="ff-myteam__formation-label">Formacija</span>
                    <span class="ff-myteam__formation-value" data-role="formation-label">@Model.FormationLabel</span>
                </div>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(savedMsg))
    {
        <div class="ff-myteam-toast ff-myteam-toast--success" role="status" aria-live="polite">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            <span>@savedMsg</span>
            <button type="button" class="ff-myteam-toast__close" aria-label="Zatvori" data-dismiss-toast>
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="ff-myteam-alert ff-myteam-alert--danger" role="alert">
            <div class="ff-myteam-alert__head">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <strong>Sastav nije moguće spremiti</strong>
            </div>
            <ul class="ff-myteam-alert__list">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@err.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="ff-myteam-feedback" data-role="swap-feedback" aria-live="polite"></div>

    @if (Model.Gameweeks.Any())
    {
        <nav class="ff-gw-slider" aria-label="Navigacija po kolima">
            <div class="ff-gw-slider__nav">
                @if (Model.ShowingGameweek)
                {
                    @if (Model.PrevGameweek != null)
                    {
                        <a class="ff-gw-slider__arrow"
                           asp-controller="FantasyTeam" asp-action="MyTeam" asp-route-gw="@Model.PrevGameweek.Number"
                           aria-label="Prethodno kolo (Kolo @Model.PrevGameweek.Number)" rel="prev">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </a>
                    }
                    else
                    {
                        <a class="ff-gw-slider__arrow"
                           asp-controller="FantasyTeam" asp-action="MyTeam"
                           aria-label="Natrag na sezonu" rel="prev">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </a>
                    }

                    <span class="ff-gw-slider__current" aria-current="true">Kolo @Model.SelectedGameweek</span>

                    @if (Model.NextGameweek != null)
                    {
                        <a class="ff-gw-slider__arrow"
                           asp-controller="FantasyTeam" asp-action="MyTeam" asp-route-gw="@Model.NextGameweek.Number"
                           aria-label="Sljedeće kolo (Kolo @Model.NextGameweek.Number)" rel="next">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    }
                    else
                    {
                        <span class="ff-gw-slider__arrow ff-gw-slider__arrow--disabled" aria-disabled="true">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </span>
                    }
                }
                else
                {
                    <span class="ff-gw-slider__arrow ff-gw-slider__arrow--disabled" aria-disabled="true">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </span>

                    <span class="ff-gw-slider__current ff-gw-slider__current--season" aria-current="true">Sezona</span>

                    @if (firstGw != null)
                    {
                        <a class="ff-gw-slider__arrow"
                           asp-controller="FantasyTeam" asp-action="MyTeam" asp-route-gw="@firstGw.Number"
                           aria-label="Prvo kolo (Kolo @firstGw.Number)" rel="next">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    }
                }
            </div>

            <div class="ff-gw-slider__readout" aria-live="polite">
                @if (Model.ShowingGameweek)
                {
                    <span>Kolo @Model.SelectedGameweek:</span>
                    <span class="ff-gw-slider__readout-value">@(Model.GameweekTeamPoints ?? 0)</span>
                    <span>bodova</span>
                }
                else
                {
                    <span>Ukupno:</span>
                    <span class="ff-gw-slider__readout-value">@Model.SeasonTotalPoints</span>
                    <span>bodova</span>
                }
            </div>

            @if (Model.ShowingGameweek)
            {
                <a class="ff-gw-slider__reset" asp-controller="FantasyTeam" asp-action="MyTeam">
                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                    <span>Sezona</span>
                </a>
            }
        </nav>
    }

    @{
        // Per-gameweek points context for the pitch shirts (consumed by _PitchPlayer).
        ViewData["ShowGwPoints"] = Model.ShowingGameweek;
        ViewData["GwPoints"] = Model.PlayerGameweekPoints;
    }

    <form asp-controller="FantasyTeam" asp-action="SaveLineup" method="post"
          class="ff-myteam__form" id="ffMyTeamForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="teamId" value="@Model.TeamId" />

        <div class="ff-myteam__stage">

            <div class="ff-pitch" data-role="pitch" aria-label="Početni sastav">
                <div class="ff-pitch__lines" aria-hidden="true">
                    <span class="ff-pitch__line ff-pitch__line--center"></span>
                    <span class="ff-pitch__line ff-pitch__circle"></span>
                    <span class="ff-pitch__line ff-pitch__spot ff-pitch__spot--center"></span>
                    <span class="ff-pitch__line ff-pitch__box ff-pitch__box--top"></span>
                    <span class="ff-pitch__line ff-pitch__box ff-pitch__box--top-six"></span>
                    <span class="ff-pitch__line ff-pitch__box ff-pitch__box--bottom"></span>
                    <span class="ff-pitch__line ff-pitch__box ff-pitch__box--bottom-six"></span>
                    <span class="ff-pitch__line ff-pitch__spot ff-pitch__spot--top"></span>
                    <span class="ff-pitch__line ff-pitch__spot ff-pitch__spot--bottom"></span>
                </div>

                <div class="ff-pitch__rows">
                    <div class="ff-pitch__row ff-pitch__row--fwd ff-totw__row" data-row="FWD">
                        @foreach (var p in Model.StarterForwards)
                        {
                            <partial name="_PitchPlayer" model="p" view-data='new ViewDataDictionary(ViewData) { ["IsStarter"] = true }' />
                        }
                    </div>
                    <div class="ff-pitch__row ff-pitch__row--mid ff-totw__row" data-row="MID">
                        @foreach (var p in Model.StarterMidfielders)
                        {
                            <partial name="_PitchPlayer" model="p" view-data='new ViewDataDictionary(ViewData) { ["IsStarter"] = true }' />
                        }
                    </div>
                    <div class="ff-pitch__row ff-pitch__row--def ff-totw__row" data-row="DEF">
                        @foreach (var p in Model.StarterDefenders)
                        {
                            <partial name="_PitchPlayer" model="p" view-data='new ViewDataDictionary(ViewData) { ["IsStarter"] = true }' />
                        }
                    </div>
                    <div class="ff-pitch__row ff-pitch__row--gk ff-totw__row" data-row="GK">
                        @foreach (var p in Model.StarterGoalkeepers)
                        {
                            <partial name="_PitchPlayer" model="p" view-data='new ViewDataDictionary(ViewData) { ["IsStarter"] = true }' />
                        }
                    </div>
                </div>
            </div>

            <aside class="ff-bench" aria-label="Klupa">
                <div class="ff-bench__header">
                    <span class="ff-bench__label">BENCH</span>
                    <span class="ff-bench__hint">@Model.BenchCount rezervi</span>
                </div>
                <div class="ff-bench__row" data-role="bench">
                    @foreach (var p in Model.Bench)
                    {
                        <partial name="_PitchPlayer" model="p" view-data='new ViewDataDictionary(ViewData) { ["IsStarter"] = false }' />
                    }
                </div>
            </aside>

        </div>

        <div class="ff-myteam-save-bar">
            <div class="ff-myteam-save-bar__info">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <span>Spremi sastav prije starta sljedećeg kola.</span>
            </div>
            <button type="submit" class="ff-myteam-save-btn" data-role="save-lineup">
                <span>Save Lineup</span>
            </button>
        </div>

        <div data-role="starters-hidden"></div>
    </form>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
