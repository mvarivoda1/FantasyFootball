@model List<Transfer>
@{
    ViewData["Title"] = "Transfers";

    // -----------------------------------------------------------
    // Helpers (inline, no backend change)
    // -----------------------------------------------------------
    string PosAbbr(Position p) => p switch
    {
        Position.Goalkeeper => "GK",
        Position.Defender   => "DEF",
        Position.Midfielder => "MID",
        Position.Forward    => "FWD",
        _ => "MID"
    };

    string PosBadgeClass(Position p) => p switch
    {
        Position.Goalkeeper => "ff-badge--gk",
        Position.Defender   => "ff-badge--def",
        Position.Midfielder => "ff-badge--mid",
        Position.Forward    => "ff-badge--fwd",
        _ => "ff-badge--mid"
    };

    string StatusBadgeClass(TransferStatus s) => s switch
    {
        TransferStatus.Accepted  => "ff-badge--accepted",
        TransferStatus.Pending   => "ff-badge--pending",
        TransferStatus.Rejected  => "ff-badge--rejected",
        TransferStatus.Cancelled => "ff-badge--cancelled",
        _ => "ff-badge--pending"
    };

    var all = Model ?? new List<Transfer>();

    // -----------------------------------------------------------
    // Trend datasets
    // -----------------------------------------------------------
    var mostExpensive = all
        .Where(t => t.Status == TransferStatus.Accepted)
        .OrderByDescending(t => t.Price)
        .ToList();

    var transfersIn = all
        .Where(t => t.Status == TransferStatus.Accepted)
        .OrderByDescending(t => t.TransferDate)
        .ToList();

    var transfersOut = all
        .Where(t => t.FromTeam != null && t.Status == TransferStatus.Accepted)
        .OrderByDescending(t => t.TransferDate)
        .ToList();

    var pending = all
        .Where(t => t.Status == TransferStatus.Pending)
        .OrderByDescending(t => t.TransferDate)
        .ToList();

    var freeAgentSignings = all
        .Where(t => t.FromTeam == null && t.Status == TransferStatus.Accepted)
        .OrderByDescending(t => t.TransferDate)
        .ToList();

    var rejectedCancelled = all
        .Where(t => t.Status == TransferStatus.Rejected || t.Status == TransferStatus.Cancelled)
        .OrderByDescending(t => t.TransferDate)
        .ToList();
}

<!-- Breadcrumb -->
<ul class="ff-breadcrumb">
    <li class="ff-breadcrumb__item"><a asp-controller="Home" asp-action="Index">Home</a></li>
    <li class="ff-breadcrumb__separator"><i class="bi bi-chevron-right"></i></li>
    <li class="ff-breadcrumb__item ff-breadcrumb__item--active">Transfers</li>
</ul>

<!-- Page header -->
<header class="ff-page-header ff-animate-in">
    <div class="ff-page-header__main">
        <h1 class="ff-page-header__title"><i class="bi bi-arrow-left-right"></i> Transfer Trends</h1>
        <p class="ff-page-header__meta">
            <span class="ff-page-header__meta-item">
                <i class="bi bi-activity"></i> @all.Count total transfers
            </span>
            <span class="ff-page-header__meta-item">
                <i class="bi bi-check-circle-fill"></i> @all.Count(t => t.Status == TransferStatus.Accepted) accepted
            </span>
            <span class="ff-page-header__meta-item">
                <i class="bi bi-hourglass-split"></i> @pending.Count pending
            </span>
        </p>
    </div>
    <p class="ff-page-header__description">
        A dashboard of transfer activity across the league &mdash; pick a trend card and click &ldquo;View all&rdquo; for the full list.
    </p>
</header>

@if (!all.Any())
{
    <div class="ff-empty">
        <div class="ff-empty__icon"><i class="bi bi-arrow-left-right"></i></div>
        <div class="ff-empty__text">No transfers recorded yet.</div>
    </div>
}
else
{
    // ---------- Local render helper: builds a .ff-player-link anchor ----------
    // Returns IHtmlContent so Razor emits the HTML without re-encoding.
    Microsoft.AspNetCore.Html.IHtmlContent PlayerLink(Player p)
    {
        var nameEnc      = System.Net.WebUtility.HtmlEncode(p.FullName ?? "");
        var clubEnc      = System.Net.WebUtility.HtmlEncode(p.Club ?? "");
        var natEnc       = System.Net.WebUtility.HtmlEncode(p.Nationality ?? "");
        var teamsJson    = System.Text.Json.JsonSerializer.Serialize(
                              p.FantasyTeams?.Select(t => new { t.Id, t.Name, t.OwnerName, t.TotalPoints }));
        var teamsJsonEnc = System.Net.WebUtility.HtmlEncode(teamsJson);

        var sb = new System.Text.StringBuilder();
        sb.Append("<a href=\"#\" class=\"ff-player-link ff-widget-row__name\" role=\"button\" tabindex=\"0\"");
        sb.Append(" aria-haspopup=\"dialog\" aria-label=\"Open locker for ").Append(nameEnc).Append("\"");
        sb.Append(" data-player-id=\"").Append(p.Id).Append("\"");
        sb.Append(" data-player-name=\"").Append(nameEnc).Append("\"");
        sb.Append(" data-player-club=\"").Append(clubEnc).Append("\"");
        sb.Append(" data-player-nationality=\"").Append(natEnc).Append("\"");
        sb.Append(" data-player-position=\"").Append(p.Position).Append("\"");
        sb.Append(" data-player-pos-abbr=\"").Append(PosAbbr(p.Position)).Append("\"");
        sb.Append(" data-player-badge=\"").Append(PosBadgeClass(p.Position)).Append("\"");
        sb.Append(" data-player-dob=\"").Append(p.DateOfBirth.ToString("dd MMM yyyy")).Append("\"");
        sb.Append(" data-player-value=\"").Append(p.MarketValue.ToString("N0")).Append("\"");
        sb.Append(" data-player-goals=\"").Append(p.Goals).Append("\"");
        sb.Append(" data-player-assists=\"").Append(p.Assists).Append("\"");
        sb.Append(" data-player-cleansheets=\"").Append(p.CleanSheets).Append("\"");
        sb.Append(" data-player-points=\"").Append(p.TotalPoints).Append("\"");
        sb.Append(" data-player-teams='").Append(teamsJsonEnc).Append("'>");
        sb.Append(nameEnc);
        sb.Append("</a>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }

    <!-- Grid of trend widgets -->
    <div class="row g-4">

        <!-- ==================== 1. Most Expensive ==================== -->
        <section class="col-lg-6 col-xl-4">
            <div class="ff-widget-card ff-widget-card--expensive" data-trend-id="expensive">
                <div class="ff-widget-card__header">
                    <h2 class="ff-widget-card__title">
                        <i class="bi bi-gem"></i> Most Expensive
                    </h2>
                    <span class="ff-widget-card__count">@mostExpensive.Count total</span>
                </div>
                <div class="ff-widget-card__body ff-widget-card__body--list">
                    @if (mostExpensive.Any())
                    {
                        <ol class="ff-widget-list ff-widget-list--ranked">
                            @{ int er = 1; }
                            @foreach (var t in mostExpensive.Take(5))
                            {
                                <li class="ff-widget-row">
                                    <div class="ff-widget-row__rank">@er</div>
                                    <div class="ff-widget-row__main">
                                        @PlayerLink(t.Player)
                                        <span class="ff-widget-row__sub">@t.Player.Club &middot; @t.ToTeam.Name</span>
                                    </div>
                                    <div class="ff-trend-row__metric ff-trend-row__metric--price">
                                        &euro;@t.Price.ToString("N0")
                                    </div>
                                </li>
                                er++;
                            }
                        </ol>
                    }
                    else
                    {
                        <div class="ff-widget-card__empty">
                            <i class="bi bi-gem"></i>
                            No accepted transfers yet.
                        </div>
                    }
                </div>
                @if (mostExpensive.Any())
                {
                    <div class="ff-widget-card__footer">
                        <button type="button"
                                class="ff-btn ff-btn--outline ff-btn--sm ff-trend-viewall"
                                data-trend-id="expensive"
                                data-trend-title="Most Expensive Transfers"
                                data-trend-icon="bi-gem">
                            View all @mostExpensive.Count <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                    <!-- Hidden full list, cloned into modal -->
                    <div class="ff-trend-widget__full" data-trend-content="expensive">
                        <div class="ff-table-responsive">
                            <table class="ff-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Player</th>
                                        <th>From</th>
                                        <th>To</th>
                                        <th class="text-end">Price</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int erFull = 1; }
                                    @foreach (var t in mostExpensive)
                                    {
                                        <tr>
                                            <td class="ff-table__rank">@erFull</td>
                                            <td>@PlayerLink(t.Player)</td>
                                            <td>
                                                @if (t.FromTeam != null)
                                                {
                                                    <a asp-controller="FantasyTeam" asp-action="Details" asp-route-id="@t.FromTeam.Id">@t.FromTeam.Name</a>
                                                }
                                                else
                                                {
                                                    <span class="ff-text-muted">Free Agent</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-controller="FantasyTeam" asp-action="Details" asp-route-id="@t.ToTeam.Id">@t.ToTeam.Name</a>
                                            </td>
                                            <td class="ff-num text-end">&euro;@t.Price.ToString("N0")</td>
                                            <td><span class="ff-text-muted ff-text-sm">@t.TransferDate.ToString("dd MMM yyyy")</span></td>
                                            <td><span class="ff-badge @StatusBadgeClass(t.Status)">@t.Status</span></td>
                                        </tr>
                                        erFull++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </section>

