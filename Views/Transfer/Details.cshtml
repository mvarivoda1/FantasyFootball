@model Transfer
@{
    ViewData["Title"] = $"Transfer - {Model.Player.FullName}";

    string dirClass = Model.Direction == TransferDirection.In ? "ff-badge--in" : "ff-badge--out";
    string dirLabel = Model.Direction == TransferDirection.In ? "IN" : "OUT";
    string dirIcon = Model.Direction == TransferDirection.In ? "bi-arrow-down-circle-fill" : "bi-arrow-up-circle-fill";
}

<!-- Breadcrumb -->
<ul class="ff-breadcrumb">
    <li class="ff-breadcrumb__item"><a asp-controller="Home" asp-action="Index">Home</a></li>
    <li class="ff-breadcrumb__separator"><i class="bi bi-chevron-right"></i></li>
    <li class="ff-breadcrumb__item"><a asp-controller="Transfer" asp-action="Index">Transfers</a></li>
    <li class="ff-breadcrumb__separator"><i class="bi bi-chevron-right"></i></li>
    <li class="ff-breadcrumb__item ff-breadcrumb__item--active">@Model.Player.FullName</li>
</ul>

<!-- Hero -->
<div class="ff-hero ff-animate-in">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h1 class="ff-hero__title">Transfer Details</h1>
            <p class="ff-hero__subtitle mb-0">
                <a asp-controller="Player" asp-action="Details" asp-route-id="@Model.Player.Id" style="color: var(--fpl-green);">
                    @Model.Player.FullName
                </a>
            </p>
        </div>
        <span class="ff-badge @dirClass" style="font-size: 0.95rem; padding: 0.45rem 1.1rem;">
            <i class="bi @dirIcon"></i> @dirLabel
        </span>
    </div>
</div>

<!-- Stat cards -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-4">
        <div class="ff-stat-card">
            <div class="ff-stat-card__icon"><i class="bi bi-person-fill"></i></div>
            <div class="ff-stat-card__value">
                <a asp-controller="Player" asp-action="Details" asp-route-id="@Model.Player.Id">
                    @Model.Player.FullName
                </a>
            </div>
            <div class="ff-stat-card__label">Player</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="ff-stat-card">
            <div class="ff-stat-card__icon"><i class="bi bi-shield-fill"></i></div>
            <div class="ff-stat-card__value">
                @if (Model.Team != null)
                {
                    <a asp-controller="FantasyTeam" asp-action="Details" asp-route-id="@Model.Team.Id">
                        @Model.Team.Name
                    </a>
                }
                else
                {
                    <span class="ff-text-muted">—</span>
                }
            </div>
            <div class="ff-stat-card__label">Team</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="ff-stat-card">
            <div class="ff-stat-card__icon"><i class="bi @dirIcon"></i></div>
            <div class="ff-stat-card__value"><span class="ff-badge @dirClass">@dirLabel</span></div>
            <div class="ff-stat-card__label">Direction</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="ff-stat-card">
            <div class="ff-stat-card__icon"><i class="bi bi-cash-stack"></i></div>
            <div class="ff-stat-card__value">&euro;@Model.Price.ToString("N0")</div>
            <div class="ff-stat-card__label">Price</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="ff-stat-card">
            <div class="ff-stat-card__icon"><i class="bi bi-calendar3"></i></div>
            <div class="ff-stat-card__value">@Model.TransferDate.ToString("dd MMM yyyy")</div>
            <div class="ff-stat-card__label">Date</div>
        </div>
    </div>
    @if (Model.League != null)
    {
        <div class="col-md-6 col-lg-4">
            <div class="ff-stat-card">
                <div class="ff-stat-card__icon"><i class="bi bi-diagram-3-fill"></i></div>
                <div class="ff-stat-card__value">
                    <a asp-controller="League" asp-action="Details" asp-route-id="@Model.League.Id">
                        @Model.League.Name
                    </a>
                </div>
                <div class="ff-stat-card__label">League</div>
            </div>
        </div>
    }
</div>

<a asp-controller="Transfer" asp-action="Index" class="ff-btn ff-btn--outline">
    <i class="bi bi-arrow-left"></i> Back to Transfers
</a>
